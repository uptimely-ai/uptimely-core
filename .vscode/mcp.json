{
  "servers": {
    "uptimely": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/bin/uptimely-mcp",
      "cwd": "${workspaceFolder}",
      "args": [
        "--analytics",
        "${workspaceFolder}/examples/pump_analytics/_generated/analytics/analytics.json",
        "--project-root",
        "${workspaceFolder}",
        "--config",
        "${workspaceFolder}/examples/pump_analytics/config/engine.json"
      ]
    }
  }
}
