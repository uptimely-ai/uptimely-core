{
  "servers": {
    "uptimely": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/bin/uptimely-mcp",
      "cwd": "${workspaceFolder}",
      "args": [
        "--spec",
        "${workspaceFolder}/examples/pump_analytics/_generated/build/spec.json",
        "--project-root",
        "${workspaceFolder}",
        "--config",
        "${workspaceFolder}/examples/pump_analytics/config/engine.json"
      ]
    }
  }
}
