{
  "name": "Observation totals",
  "spec_version": 2,
  "dimensions": {
    "id": {
      "type": "integer"
    }
  },
  "functions": {
    "read_observations": {
      "operation": "read",
      "returns": "dataframe",
      "entrypoint": "conftest:read_observation_totals"
    },
    "sum_features": {
      "operation": "vectorize",
      "returns": "dataframe",
      "entrypoint": "conftest:sum_observation_features",
      "args": {
        "left_feature": {"type": "string"},
        "right_feature": {"type": "string"},
        "output": {"type": "string"},
        "dataset": {"type": "dataframe"}
      }
    }
  },
  "entities": {
    "observation": {
      "name": "Observation",
      "dimensions": ["id"],
      "datasets": {
        "observations": {
          "features": {
            "id": {"type": "integer"},
            "input_1": {"type": "integer"},
            "input_2": {"type": "integer"},
            "total": {"type": "integer"}
          },
          "mappings": {
            "read_observations": {
              "binding": {
                "function": "read_observations"
              },
              "features": {
                "outputs": [
                  "$features.id",
                  "$features.input_1",
                  "$features.input_2"
                ]
              }
            },
            "calculate_total": {
              "binding": {
                "function": "sum_features",
                "args": {
                  "left_feature": "$features.input_1",
                  "right_feature": "$features.input_2",
                  "output": "$features.total",
                  "dataset": "$datasets.@.dataframe"
                }
              },
              "features": {
                "inputs": ["$features.input_1", "$features.input_2"],
                "outputs": ["$features.total"]
              }
            }
          }
        }
      }
    }
  }
}
