{
  "name": "Observation totals",
  "spec_version": 8,
  "dimensions": {
    "id": {
      "resolutions": {
        "id": {
          "key": "id",
          "type": "integer"
        }
      }
    }
  },
  "functions": {
    "read_observations": {
      "returns": "dataframe",
      "entrypoint": "support.functions:read_observation_totals"
    },
    "sum_features": {
      "returns": "dataframe",
      "entrypoint": "support.functions:sum_observation_features",
      "args": {
        "left_feature": {
          "type": "string"
        },
        "right_feature": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "dataset": {
          "type": "dataframe"
        }
      }
    }
  },
  "profiles": {
    "observations": {
      "name": "Observations",
      "grain": [
        {
          "dimension": "id",
          "resolution": "id"
        }
      ],
      "features": {
        "input_1": {
          "type": "integer"
        },
        "input_2": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        }
      },
      "assembly": {
        "read_observations": {
          "compute": {
            "function": "read_observations"
          },
          "interface": {
            "outputs": [
              "$features.input_1",
              "$features.input_2"
            ]
          },
          "merge": {
            "function": "merge_by_grain",
            "args": {
              "dataset": "$profiles.@.dataset",
              "fragment": "$operators.@.fragment",
              "dataset_identifiers": "$profiles.@.grain.ids"
            }
          }
        },
        "calculate_total": {
          "compute": {
            "function": "sum_features",
            "args": {
              "left_feature": "$features.input_1",
              "right_feature": "$features.input_2",
              "output": "$features.total",
              "dataset": "$profiles.@.dataset"
            }
          },
          "interface": {
            "inputs": [
              "$features.input_1",
              "$features.input_2"
            ],
            "outputs": [
              "$features.total"
            ]
          }
        }
      }
    }
  }
}
