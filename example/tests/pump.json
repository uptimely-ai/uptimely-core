{
  "select_series_max_capacity": {
    "cases": {
      "basic": {
        "inputs": {
          "dataset": [
            {
              "machine_series_id": "S1",
              "max_capacity_series": 90.0
            },
            {
              "machine_series_id": "S2",
              "max_capacity_series": 120.0
            },
            {
              "machine_series_id": "S3",
              "max_capacity_series": null
            }
          ]
        },
        "expected": {
          "return": [
            {
              "machine_series_id": "S1",
              "series_max_capacity": 90.0
            },
            {
              "machine_series_id": "S2",
              "series_max_capacity": 120.0
            },
            {
              "machine_series_id": "S3",
              "series_max_capacity": null
            }
          ]
        }
      }
    }
  },
  "select_category_max_capacity": {
    "cases": {
      "basic": {
        "inputs": {
          "dataset": [
            {
              "machine_category_id": "C1",
              "max_capacity_category": 100.0
            },
            {
              "machine_category_id": "C2",
              "max_capacity_category": 200.0
            },
            {
              "machine_category_id": "C3",
              "max_capacity_category": null
            }
          ]
        },
        "expected": {
          "return": [
            {
              "machine_category_id": "C1",
              "category_max_capacity": 100.0
            },
            {
              "machine_category_id": "C2",
              "category_max_capacity": 200.0
            },
            {
              "machine_category_id": "C3",
              "category_max_capacity": null
            }
          ]
        }
      }
    }
  },
  "resolve_max_capacity": {
    "cases": {
      "series_fallback": {
        "inputs": {
          "dataset": [
            {
              "pump_max_capacity": null,
              "series_max_capacity": 90.0,
              "category_max_capacity": 100.0
            },
            {
              "pump_max_capacity": null,
              "series_max_capacity": 75.0,
              "category_max_capacity": null
            },
            {
              "pump_max_capacity": null,
              "series_max_capacity": 0.0,
              "category_max_capacity": 100.0
            }
          ]
        },
        "expected": {
          "return": [
            {
              "pump_max_capacity": null,
              "series_max_capacity": 90.0,
              "category_max_capacity": 100.0,
              "max_capacity": 90.0
            },
            {
              "pump_max_capacity": null,
              "series_max_capacity": 75.0,
              "category_max_capacity": null,
              "max_capacity": 75.0
            },
            {
              "pump_max_capacity": null,
              "series_max_capacity": 0.0,
              "category_max_capacity": 100.0,
              "max_capacity": 0.0
            }
          ]
        }
      },
      "pump_first": {
        "inputs": {
          "dataset": [
            {
              "pump_max_capacity": 80.0,
              "series_max_capacity": 90.0,
              "category_max_capacity": 100.0
            },
            {
              "pump_max_capacity": 0.0,
              "series_max_capacity": 90.0,
              "category_max_capacity": 100.0
            },
            {
              "pump_max_capacity": 110.0,
              "series_max_capacity": null,
              "category_max_capacity": 100.0
            }
          ]
        },
        "expected": {
          "return": [
            {
              "pump_max_capacity": 80.0,
              "series_max_capacity": 90.0,
              "category_max_capacity": 100.0,
              "max_capacity": 80.0
            },
            {
              "pump_max_capacity": 0.0,
              "series_max_capacity": 90.0,
              "category_max_capacity": 100.0,
              "max_capacity": 0.0
            },
            {
              "pump_max_capacity": 110.0,
              "series_max_capacity": null,
              "category_max_capacity": 100.0,
              "max_capacity": 110.0
            }
          ]
        }
      }
    }
  },
  "bearing_temperature_by_pump": {
    "cases": {
      "basic": {
        "inputs": {
          "dataset": [
            {
              "pump_id": "P1",
              "bearing_temperature": 60.0
            },
            {
              "pump_id": "P1",
              "bearing_temperature": 70.0
            },
            {
              "pump_id": "P1",
              "bearing_temperature": 65.0
            }
          ]
        },
        "expected": {
          "return": [
            {
              "pump_id": "P1",
              "bearing_temperature_max": 70.0
            }
          ]
        }
      }
    }
  },
  "normalize_bearing_temperature": {
    "cases": {
      "basic": {
        "inputs": {
          "dataset": [
            {
              "bearing_temperature_max": 60.0
            },
            {
              "bearing_temperature_max": 70.0
            },
            {
              "bearing_temperature_max": 65.0
            }
          ]
        },
        "expected": {
          "return": [
            {
              "bearing_temperature_max": 60.0,
              "health_signal_normalized": -1.0
            },
            {
              "bearing_temperature_max": 70.0,
              "health_signal_normalized": 1.0
            },
            {
              "bearing_temperature_max": 65.0,
              "health_signal_normalized": 0.0
            }
          ]
        }
      }
    }
  }
}
