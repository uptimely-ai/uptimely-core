{
  "classify_pump_mode": {
    "cases": {
      "warning": {
        "inputs": {
          "dataset": [
            {
              "bearing_temperature": 90.0,
              "vibration_rms": 3.0
            },
            {
              "bearing_temperature": 80.0,
              "vibration_rms": 4.5
            },
            {
              "bearing_temperature": 95.0,
              "vibration_rms": 5.0
            }
          ]
        },
        "expected": {
          "return": [
            {
              "bearing_temperature": 90.0,
              "vibration_rms": 3.0,
              "pump_mode": "warning"
            },
            {
              "bearing_temperature": 80.0,
              "vibration_rms": 4.5,
              "pump_mode": "warning"
            },
            {
              "bearing_temperature": 95.0,
              "vibration_rms": 5.0,
              "pump_mode": "warning"
            }
          ]
        }
      },
      "operational": {
        "inputs": {
          "dataset": [
            {
              "bearing_temperature": 80.0,
              "vibration_rms": 3.0
            },
            {
              "bearing_temperature": 89.0,
              "vibration_rms": 4.0
            },
            {
              "bearing_temperature": 70.0,
              "vibration_rms": 1.0
            }
          ]
        },
        "expected": {
          "return": [
            {
              "bearing_temperature": 80.0,
              "vibration_rms": 3.0,
              "pump_mode": "operational"
            },
            {
              "bearing_temperature": 89.0,
              "vibration_rms": 4.0,
              "pump_mode": "operational"
            },
            {
              "bearing_temperature": 70.0,
              "vibration_rms": 1.0,
              "pump_mode": "operational"
            }
          ]
        }
      }
    }
  },
  "calculate_pressure_flow_efficiency": {
    "cases": {
      "basic": {
        "inputs": {
          "dataset": [
            {
              "differential_pressure": 3.0,
              "flow_rate": 12.0,
              "motor_power": 2.0
            },
            {
              "differential_pressure": 6.0,
              "flow_rate": 12.0,
              "motor_power": 2.0
            },
            {
              "differential_pressure": 3.0,
              "flow_rate": 12.0,
              "motor_power": 4.0
            }
          ]
        },
        "expected": {
          "return": [
            {
              "differential_pressure": 3.0,
              "flow_rate": 12.0,
              "motor_power": 2.0,
              "pressure_flow_efficiency": 0.5
            },
            {
              "differential_pressure": 6.0,
              "flow_rate": 12.0,
              "motor_power": 2.0,
              "pressure_flow_efficiency": 1.0
            },
            {
              "differential_pressure": 3.0,
              "flow_rate": 12.0,
              "motor_power": 4.0,
              "pressure_flow_efficiency": 0.25
            }
          ]
        }
      }
    }
  },
  "select_room_temperature_reference": {
    "cases": {
      "basic": {
        "inputs": {
          "dataset": [
            {
              "room_temperature": 20.0
            }
          ]
        },
        "expected": {
          "return": [
            {
              "room_temperature_reference": 20.0
            }
          ]
        }
      }
    }
  },
  "calculate_bearing_temperature_rise": {
    "cases": {
      "basic": {
        "inputs": {
          "dataset": [
            {
              "bearing_temperature": 80.0,
              "room_temperature_reference": 20.0
            },
            {
              "bearing_temperature": 70.0,
              "room_temperature_reference": 20.0
            },
            {
              "bearing_temperature": 20.0,
              "room_temperature_reference": 20.0
            }
          ]
        },
        "expected": {
          "return": [
            {
              "bearing_temperature": 80.0,
              "room_temperature_reference": 20.0,
              "bearing_temperature_rise": 60.0
            },
            {
              "bearing_temperature": 70.0,
              "room_temperature_reference": 20.0,
              "bearing_temperature_rise": 50.0
            },
            {
              "bearing_temperature": 20.0,
              "room_temperature_reference": 20.0,
              "bearing_temperature_rise": 0.0
            }
          ]
        }
      }
    }
  },
  "calculate_bearing_temperature_delta": {
    "cases": {
      "basic": {
        "inputs": {
          "dataset": [
            {
              "pump_id": "P1",
              "timestamp": "2026-01-01T10:00:00Z",
              "bearing_temperature": 80.0
            },
            {
              "pump_id": "P1",
              "timestamp": "2026-01-01T10:01:00Z",
              "bearing_temperature": 82.0
            },
            {
              "pump_id": "P1",
              "timestamp": "2026-01-01T10:02:00Z",
              "bearing_temperature": 79.0
            }
          ]
        },
        "expected": {
          "return": [
            {
              "pump_id": "P1",
              "timestamp": "2026-01-01T10:00:00Z",
              "bearing_temperature": 80.0,
              "bearing_temperature_delta": null
            },
            {
              "pump_id": "P1",
              "timestamp": "2026-01-01T10:01:00Z",
              "bearing_temperature": 82.0,
              "bearing_temperature_delta": 2.0
            },
            {
              "pump_id": "P1",
              "timestamp": "2026-01-01T10:02:00Z",
              "bearing_temperature": 79.0,
              "bearing_temperature_delta": -3.0
            }
          ]
        }
      }
    }
  },
  "calculate_vibration_delta": {
    "cases": {
      "basic": {
        "inputs": {
          "dataset": [
            {
              "pump_id": "P1",
              "timestamp": "2026-01-01T10:00:00Z",
              "vibration_rms": 2.0
            },
            {
              "pump_id": "P1",
              "timestamp": "2026-01-01T10:01:00Z",
              "vibration_rms": 3.0
            },
            {
              "pump_id": "P1",
              "timestamp": "2026-01-01T10:02:00Z",
              "vibration_rms": 2.5
            }
          ]
        },
        "expected": {
          "return": [
            {
              "pump_id": "P1",
              "timestamp": "2026-01-01T10:00:00Z",
              "vibration_rms": 2.0,
              "vibration_delta": null
            },
            {
              "pump_id": "P1",
              "timestamp": "2026-01-01T10:01:00Z",
              "vibration_rms": 3.0,
              "vibration_delta": 1.0
            },
            {
              "pump_id": "P1",
              "timestamp": "2026-01-01T10:02:00Z",
              "vibration_rms": 2.5,
              "vibration_delta": -0.5
            }
          ]
        }
      }
    }
  },
  "calculate_pump_health_score": {
    "cases": {
      "basic": {
        "inputs": {
          "dataset": [
            {
              "bearing_temperature_delta": 2.0,
              "vibration_delta": 1.0,
              "pressure_flow_efficiency": 1.0
            },
            {
              "bearing_temperature_delta": -1.0,
              "vibration_delta": -0.5,
              "pressure_flow_efficiency": 0.8
            },
            {
              "bearing_temperature_delta": 0.0,
              "vibration_delta": 0.0,
              "pressure_flow_efficiency": 0.7
            }
          ]
        },
        "expected": {
          "return": [
            {
              "bearing_temperature_delta": 2.0,
              "vibration_delta": 1.0,
              "pressure_flow_efficiency": 1.0,
              "pump_health_score": 0.3
            },
            {
              "bearing_temperature_delta": -1.0,
              "vibration_delta": -0.5,
              "pressure_flow_efficiency": 0.8,
              "pump_health_score": 0.45
            },
            {
              "bearing_temperature_delta": 0.0,
              "vibration_delta": 0.0,
              "pressure_flow_efficiency": 0.7,
              "pump_health_score": 0.7
            }
          ]
        }
      }
    }
  }
}
