  "entities": {
    "entity": {
      "name": "entity",
      "description": null,
      "dimensions": [
        "id"
      ],
      "datasets": [
        {
          "description": "Dataset loaded by read.",
          "row_scope": {
            "grain": "One row per id",
            "filtering": "",
            "coverage": ""
          },
          "read": {
            "read": {
              "binding": {
                "function": "read",
                "args": {}
              },
              "features": {
                "input_1": {
                  "description": "Input feature: input_1",
                  "type": "object",
                  "unit": null
                },
                "input_2": {
                  "description": "Input feature: input_2",
                  "type": "object",
                  "unit": null
                },
                "id": {
                  "description": "Stable identifier for each input row",
                  "type": "object",
                  "unit": null
                }
              }
            }
          },
          "conform": {},
          "expand": {},
          "collapse": {},
          "vectorize": {
            "column_3": {
              "description": "Vectorized feature: column_3",
              "unit": null,
              "binding": {
                "function": "sum_features",
                "args": {
                  "left_feature": "$features.input_1",
                  "right_feature": "$features.input_2",
                  "output": "$features.column_3"
                }
              }
            },
            "column_4": {
              "description": "Vectorized feature: column_4",
              "unit": null,
              "binding": {
                "function": "column_4",
                "args": {
                  "output": "$features.column_4",
                  "id_column": "$dimensions.id"
                }
              }
            }
          },
          "write": {
            "write": {
              "binding": {
                "function": "write",
                "args": {
                  "df": "$datasets.@",
                  "cols": [
                    "$features.column_3",
                    "$features.column_4"
                  ]
                }
              }
            }
          },
          "id": "my_beautiful_dataset"
        }
      ]
    }
  }
