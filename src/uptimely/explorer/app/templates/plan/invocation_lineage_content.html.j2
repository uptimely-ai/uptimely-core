{% from "graph/components.html.j2" import node_details_panel, lineage_canvas, lineage_legend %}
<section id="invocation-lineage-graph" class="absolute inset-0">
		{% call lineage_legend("Legend") %}
				<span class="legend-heading">Datasets</span>
				<div class="dataset-legend" id="dataset-legend"></div>
		{% endcall %}
		{{ node_details_panel("details details-2d", "Invocation details", "invocation-node-details", "Select an invocation to inspect its function kind, arguments, entity, declared features, and invocation dependencies.") }}
		{{ lineage_canvas() }}
</section>
<script id="graph-data" type="application/json">{{ invocation_lineage_data|safe }}</script>
<script id="graph-style" type="application/json">{{ graph_style_data|tojson }}</script>
