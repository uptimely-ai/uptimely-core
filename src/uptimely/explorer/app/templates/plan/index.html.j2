{% extends "base.html.j2" %}
{% block title %}Plan {{ section_title }}{% endblock %}
{% block content %}
  <div class="model-grid pointer-events-none fixed inset-0 -z-0 opacity-30"></div>
  <div class="relative z-10 mx-auto max-w-7xl px-5 py-8 sm:px-8 lg:px-10">
    <header class="mb-10 border-b border-slate-800/80 pb-5">
      <p class="font-display text-sm font-bold text-white">openanalytics<span class="text-cyan-300">/</span>compile</p>
      <p class="mt-1 font-mono text-[10px] uppercase tracking-[.2em] text-slate-500">plan {{ plan_version }}</p>
    </header>
    <main>
      <header class="mb-8 border-b border-slate-800/80 pb-6">
        <p class="mb-2 font-mono text-[10px] uppercase tracking-[.2em] text-slate-500">Plan</p>
        <h1 class="title-with-icon font-display text-3xl font-semibold tracking-tight text-white">{{ icon("stages" if active_section == "stages" else "overview", "title-icon") }}<span>{{ section_title }}</span></h1>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-400">{% if active_section == "stages" %}Inspect dependency-ordered callables, parallel stages, and their argument bindings.{% else %}Plan compiled from the spec, ordered by dependency resolution.{% endif %}</p>
      </header>
      {% block plan_overview %}
      <section id="plan-overview" class="mb-16">
        <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {% for label, value, icon_key in [("Callables", callable_count, "callables"), ("Functions", function_count, "functions"), ("Entities", entity_count, "entities"), ("Features", feature_count, "features"), ("Stages", stage_count, "stages"), ("Dependencies", dependency_count, "execution-graph"), ("Max parallel callables", max_parallel_callables, "stages")] %}
          <div class="rounded-2xl border border-slate-800 bg-slate-900/75 p-5" data-stat="{{ label }}">
            <div class="flex items-center justify-between gap-3"><span class="font-mono text-[10px] uppercase tracking-[.15em] text-slate-500">{{ label }}</span>{{ icon(icon_key, "nav-icon") }}</div>
            <p class="mt-4 font-display text-3xl font-semibold text-white" data-value="{{ value }}">{{ value }}</p>
          </div>
          {% endfor %}
        </div>
        <div class="mt-5 grid gap-5 lg:grid-cols-2">
          <div class="rounded-2xl border border-slate-800 bg-slate-900/75 p-5">
            <div class="mb-5 flex items-baseline justify-between gap-4"><h2 class="font-display text-lg font-semibold text-white">Callables</h2><span class="font-mono text-[10px] uppercase tracking-wider text-slate-500">total {{ callable_count }}</span></div>
            {% set operation_max = operation_counts|map(attribute=1)|max if operation_counts else 0 %}
            <div class="space-y-4">
              {% for label, value in operation_counts %}
              <div class="grid grid-cols-[5.5rem_minmax(0,1fr)_3rem] items-center gap-3" data-operation="{{ label }}" data-count="{{ value }}">
                <span class="font-mono text-xs text-slate-400">{{ label }}</span>
                <div class="h-2 overflow-hidden rounded-full bg-slate-800"><div class="h-full rounded-full bg-cyan-400" style="width: {{ (value / operation_max * 100) if operation_max else 0 }}%"></div></div>
                <span class="text-right font-mono text-xs text-white">{{ value }}</span>
              </div>
              {% else %}
              <p class="text-sm text-slate-400">No callables.</p>
              {% endfor %}
            </div>
          </div>
          <div class="rounded-2xl border border-slate-800 bg-slate-900/75 p-5">
            <div class="mb-2 flex items-baseline justify-between gap-4"><h2 class="font-display text-lg font-semibold text-white">Execution stages</h2><span class="font-mono text-[10px] uppercase tracking-wider text-slate-500">total {{ stage_count }}</span></div>
            <p class="mb-5 text-xs leading-5 text-slate-400">Callables in each stage can run independently. Actual parallel execution depends on the engine.</p>
            <div class="space-y-4">
              {% for stage in stages %}
              {% set value = stage.steps|length %}
              <div class="grid grid-cols-[5.5rem_minmax(0,1fr)_3rem] items-center gap-3" data-stage="{{ stage.stage }}" data-count="{{ value }}">
                <span class="font-mono text-xs text-slate-400">Stage {{ stage.stage }}</span>
                <div class="h-2 overflow-hidden rounded-full bg-slate-800"><div class="h-full rounded-full bg-cyan-400" style="width: {{ (value / max_parallel_callables * 100) if max_parallel_callables else 0 }}%"></div></div>
                <span class="text-right font-mono text-xs text-white">{{ value }}</span>
              </div>
              {% else %}
              <p class="text-sm text-slate-400">No execution stages.</p>
              {% endfor %}
            </div>
          </div>
        </div>
      </section>
      {% endblock %}
      {% block plan_graph %}
      {% include "plan/callable_graph.html.j2" %}
      {% endblock %}
      {% block plan_stages %}
      <section id="callables" class="mb-16">
        <div class="space-y-8">
          {% for stage in stages %}
          <section>
            <div class="mb-3 flex items-center gap-3">
              {% set stage_heading = "h2" %}
              <{{ stage_heading }} class="rounded-lg bg-slate-800 px-2.5 py-1 font-mono text-xs text-slate-300">Stage {{ stage.stage }}</{{ stage_heading }}>
              <span class="font-mono text-[10px] uppercase tracking-wider text-slate-500">{{ stage.steps | length }} parallel callable{% if stage.steps | length != 1 %}s{% endif %}</span>
            </div>
            <div class="grid grid-cols-1 gap-4">
          {% for step in stage.steps %}
          <div>
            <h3 class="mb-2 break-words font-display text-lg font-semibold text-white">{{ step.title }}</h3>
          <article class="rounded-2xl border border-slate-800 bg-slate-900/70 p-6">
            <dl class="grid overflow-hidden rounded-lg border border-slate-800 bg-slate-950/55 font-mono text-xs md:grid-cols-[8rem_minmax(0,1fr)_minmax(0,1fr)_10rem]">
              <div class="min-w-0 border-b border-slate-800 p-3 md:border-r">
                <dt class="mb-1 uppercase tracking-wider text-slate-500">Operation</dt>
                <dd class="text-amber-200">{{ step.operation }}</dd>
              </div>
              <div class="min-w-0 border-b border-slate-800 p-3 md:border-r">
                <dt class="mb-1 uppercase tracking-wider text-slate-500">Function</dt>
                <dd class="flex min-w-0 items-center gap-2 text-white">
                  <span class="break-all">{{ step.function }}</span>
                  {% if step.source_href %}<a href="{{ step.source_href }}" class="shrink-0 text-cyan-300 hover:text-cyan-200" title="Open Python module"><i data-lucide="external-link" class="h-4 w-4" aria-hidden="true"></i><span class="sr-only">Open Python module</span></a>{% endif %}
                </dd>
              </div>
              <div class="min-w-0 border-b border-slate-800 p-3 md:border-r">
              <dt class="mb-1 uppercase tracking-wider text-slate-500">{{ "Declares external outputs" if step.uncontrolled else "Produces" }}</dt>
                <dd class="break-all text-cyan-200">{{ step.feature }}</dd>
              </div>
              <div class="min-w-0 border-b border-slate-800 p-3">
              <dt class="mb-1 uppercase tracking-wider text-slate-500">{{ "Python return (ignored)" if step.uncontrolled else "Returns" }}</dt>
                <dd class="break-all text-lime-300">{{ step.returns.type.engine or "—" }}</dd>
              </div>
              <div class="min-w-0 p-3 md:col-span-4">
                <dt class="mb-1 uppercase tracking-wider text-slate-500">Depends on callables</dt>
                <dd class="flex flex-wrap gap-1.5">
                  {% if step.depends_on_callables %}
                    {% for dependency in step.depends_on_callables %}<span class="rounded-md bg-slate-950/70 px-2 py-1 text-slate-300">{{ dependency.function }}</span>{% endfor %}
                  {% else %}
                    <span class="text-slate-400">No callable dependencies</span>
                  {% endif %}
                </dd>
              </div>
            </dl>
            {% if step.uncontrolled %}
            <p class="mt-3 rounded-lg border border-violet-900/60 bg-violet-950/30 p-3 text-xs leading-5 text-violet-200">Uncontrolled external operation. Declared inputs: {{ step.input_features|join(", ") or "none" }}. Declared outputs are not verified or materialized as dataframe columns.</p>
            {% endif %}
            {% if step.row_context is not none %}
            <div class="mt-3 font-mono text-xs text-slate-400">Row context: {{ step.row_context | tojson }}</div>
            {% endif %}
            {% if step.args %}
            <div class="mt-5 overflow-x-auto rounded-xl border border-slate-800 bg-slate-950/80">
              <table class="w-full font-mono text-xs">
                <thead><tr class="border-b border-slate-800 text-left text-slate-500"><th class="px-4 py-2 font-normal uppercase tracking-wider">Argument</th><th class="px-4 py-2 font-normal uppercase tracking-wider">Value</th><th class="px-4 py-2 font-normal uppercase tracking-wider">Binding type</th><th class="px-4 py-2 font-normal uppercase tracking-wider">Function type</th><th class="px-4 py-2 font-normal uppercase tracking-wider">Engine type</th></tr></thead>
                <tbody>
                  {% for argument_id, argument in step.args.items() %}
                  <tr class="border-b border-slate-800/60 last:border-0"><td class="px-4 py-2 text-cyan-200">{{ argument_id }}</td><td class="px-4 py-2 break-all text-white">{{ argument.value }}</td><td class="px-4 py-2 text-slate-400">{{ argument.type.binding or "—" }}</td><td class="px-4 py-2 text-slate-400">{{ argument.type.function or "—" }}</td><td class="px-4 py-2 text-lime-300">{{ argument.type.engine or "—" }}</td></tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
            {% endif %}
          </article>
          </div>
          {% endfor %}
            </div>
          </section>
          {% endfor %}
        </div>
      </section>
      {% endblock %}
    </main>
  </div>
{% endblock %}
