<section id="callable-graph" class="absolute inset-0">
		{% include "graph/view_controls.html.j2" %}
		<div class="panel">
			<div class="legend" aria-label="Execution graph legend">
				{% for function_type, color in graph_style.function_colors.items() %}
				<span class="function" style="--color:{{ color }}">{{ function_type|title }} function</span>
				{% endfor %}
			</div>
		</div>
		<div class="details details-2d" id="callable-node-details">
			<h3 class="mb-2 font-mono text-xs uppercase tracking-wider text-slate-400">Callable details</h3>
			<div class="text-sm leading-6 text-slate-300">Select a callable to inspect its operation, entity, declared features, and callable dependencies.</div>
		</div>
		<div id="graph">
			<div id="graph-2d" class="graph-view"></div>
			<div id="graph-3d" class="graph-view" hidden></div>
		</div>
</section>
<script id="graph-data" type="application/json">{{ callable_graph_data|safe }}</script>
<script id="graph-style" type="application/json">{{ graph_style_data|tojson }}</script>
<script src="{{ root_path or "" }}js/view_controller.js"></script>
<script src="{{ root_path or "" }}js/callable_graph.js"></script>
