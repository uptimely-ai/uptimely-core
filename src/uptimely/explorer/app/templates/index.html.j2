{% extends "base.html.j2" %}
{% block title %}{{ spec_definition.name or "Untitled analytics project" }} | OpenAnalytics{% endblock %}
{% block stylesheets %}
<link rel="stylesheet" href="{{ root_path or "" }}css/dashboard.css">
{% endblock %}
{% block content %}
<main class="dashboard">
  <header class="dashboard-hero">
    <div>
      <p class="eyebrow">OpenAnalytics / Project explorer</p>
      <h1 class="title-with-icon">{{ icon("home", "title-icon") }}<span>{{ spec_definition.name or "Untitled analytics project" }}</span></h1>
      <p class="dashboard-intro">From declared data to a dependency-aware plan.
        Explore what this analytics project defines, how its plan is compiled,
        and how its data flows through execution.</p>
      <span class="dashboard-version">Spec {{ spec_definition.spec_version }}</span>
    </div>
    <svg class="dashboard-art" viewBox="0 0 420 280" fill="none" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="journey-gradient" x1="80" y1="60" x2="340" y2="230" gradientUnits="userSpaceOnUse">
          <stop stop-color="#67e8f9"/><stop offset=".5" stop-color="#fcd34d"/><stop offset="1" stop-color="#e879f9"/>
        </linearGradient>
      </defs>
      <circle cx="210" cy="140" r="118" stroke="#334155" stroke-dasharray="3 9"/>
      <circle cx="210" cy="140" r="82" stroke="#1e293b"/>
      <path d="M88 72H190Q210 72 210 92V188Q210 208 230 208H332" stroke="url(#journey-gradient)" stroke-width="2"/>
      <path d="M88 72V208H156M264 72H332V208" stroke="#334155" stroke-dasharray="4 6"/>
      <rect x="48" y="32" width="80" height="80" rx="20" fill="#0f172a" stroke="#67e8f9"/>
      <path d="M72 53H104V91H72V53ZM79 64H97M79 72H97M79 80H89" stroke="#67e8f9" stroke-width="2"/>
      <rect x="170" y="100" width="80" height="80" rx="20" fill="#0f172a" stroke="#fcd34d"/>
      <path d="M196 124L224 140L196 156M196 124V156" stroke="#fcd34d" stroke-width="2"/>
      <circle cx="196" cy="124" r="5" fill="#0f172a" stroke="#fcd34d" stroke-width="2"/>
      <circle cx="224" cy="140" r="5" fill="#0f172a" stroke="#fcd34d" stroke-width="2"/>
      <circle cx="196" cy="156" r="5" fill="#0f172a" stroke="#fcd34d" stroke-width="2"/>
      <rect x="292" y="168" width="80" height="80" rx="20" fill="#0f172a" stroke="#e879f9"/>
      <path d="M314 193H350M314 208H338M314 223H326" stroke="#e879f9" stroke-width="3" stroke-linecap="round"/>
      <circle cx="156" cy="208" r="4" fill="#67e8f9"/>
      <circle cx="264" cy="72" r="4" fill="#e879f9"/>
    </svg>
  </header>

  <dl class="dashboard-metrics" aria-label="Project counts">
    {% for label, value in [
      ("Entities", summary.entity_count), ("Datasets", summary.dataset_count),
      ("Features", summary.feature_count), ("Functions", summary.function_count),
      ("Callables", callable_count), ("Stages", stage_count)
    ] %}
    <div data-stat="{{ label }}" data-value="{{ value }}">
      <dt>{{ label }}</dt>
      <dd>{{ value }}</dd>
    </div>
    {% endfor %}
  </dl>

  <section aria-labelledby="journey-heading">
    <p class="eyebrow">Three perspectives. One project.</p>
    <h2 class="dashboard-section-title" id="journey-heading">Follow the spec journey</h2>
    <p class="dashboard-section-intro">Start with the declarations, inspect the compiled plan, then explore execution.</p>
    <ol class="spec-journey" aria-label="Spec journey">
      {% for accent, number, title, description, href, action in [
        ("spec", "01", "Spec", "The source of truth. Browse entities, datasets, features, dimensions, and the functions bound to them.", website_pages["spec"]["overview"], "Explore spec"),
        ("plan", "02", "Plan", "The path to execution. Inspect compiled operations, argument bindings, and dependency-ordered stages with potential parallelism.", website_pages["plan"]["overview"], "Inspect the plan"),
        ("execution", "03", "Execution", "Follow color-coded processing tables and the dependencies connecting them.", website_pages["execution"]["lineage"], "Explore execution")
      ] %}
      <li class="journey-step {{ accent }} icon--{{ accent }}">
        <div class="journey-step-header">
          <span class="journey-icon">{{ icon(accent) }}</span>
          <span class="journey-number" aria-hidden="true">{{ number }}</span>
        </div>
        <h3>{{ title }}</h3>
        <p>{{ description }}</p>
        <a href="{{ href }}">{{ action }}<i data-lucide="arrow-right" aria-hidden="true"></i></a>
      </li>
      {% endfor %}
    </ol>
  </section>
  <p class="dashboard-note">A view of your declared spec, not a live execution monitor.
    Counts describe the spec and its compiled plan; building this website does not run analytical operations.</p>
</main>
{% endblock %}
