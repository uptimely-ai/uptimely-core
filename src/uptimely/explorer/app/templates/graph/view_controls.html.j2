	<div class="context-header">
		<div class="lineage-heading site-nav-heading">
			<h1 class="title-with-icon" title="{{ 'Invocation lineage' if active_page == 'plan' else 'Feature lineage' }}">{{ icon("invocation-lineage" if active_page == "plan" else "feature-lineage", "nav-icon") }}<span>{{ "Invocation lineage" if active_page == "plan" else "Feature lineage" }}</span></h1>
			<button class="nav-label-toggle context-label-toggle" type="button" aria-label="Collapse lineage context"
				aria-pressed="false" aria-controls="lineage-context" title="Collapse lineage context">
				{{ icon("collapse-navigation", "nav-icon") }}{{ icon("expand-navigation", "nav-icon") }}
			</button>
		</div>
	</div>
		<div class="lineage-control-groups">
			<div class="lineage-buttons" role="group" aria-label="Lineage view">
				<button class="ui-button" type="button" data-dimension="2d" aria-pressed="true" aria-controls="lineage-2d">2D</button>
				<button class="ui-button" type="button" data-dimension="3d" aria-pressed="false" aria-controls="lineage-3d">3D</button>
			</div>
			<div class="lineage-buttons" role="group" aria-label="Lineage zoom">
				<button class="ui-button" type="button" data-zoom="1.25" aria-label="Zoom in">+</button>
				<button class="ui-button" type="button" data-zoom="0.8" aria-label="Zoom out">-</button>
			</div>
			<div class="lineage-buttons" role="group" aria-label="Lineage reset">
				<button class="ui-button" id="reset-lineage" type="button">Reset lineage</button>
			</div>
		</div>
