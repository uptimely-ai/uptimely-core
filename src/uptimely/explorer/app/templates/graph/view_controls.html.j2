	<div class="graph-toolbar">
		<div class="graph-title-controls">
		<h1 class="title-with-icon">{{ icon("invocation-lineage" if active_page == "plan" else "feature-lineage", "title-icon") }}<span>{{ "Invocation lineage" if active_page == "plan" else "Feature lineage" }}</span></h1>
		<div class="graph-buttons" role="group" aria-label="Graph view">
			<button class="ui-button" type="button" data-dimension="2d" aria-pressed="true" aria-controls="graph-2d">2D</button>
			<button class="ui-button" type="button" data-dimension="3d" aria-pressed="false" aria-controls="graph-3d">3D</button>
		</div>
		</div>
		<div class="graph-buttons" role="group" aria-label="Graph zoom">
			<button class="ui-button" type="button" data-zoom="1.25" aria-label="Zoom in">+</button>
			<button class="ui-button" type="button" data-zoom="0.8" aria-label="Zoom out">-</button>
			<button class="ui-button" id="reset-graph" type="button">Reset graph</button>
		</div>
	</div>
	<p id="graph-error" role="alert" hidden></p>
	<noscript><p class="graph-error">JavaScript is required to display interactive graphs.</p></noscript>
