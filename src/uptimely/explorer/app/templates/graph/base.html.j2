{% extends "base.html.j2" %}
{% block body_class %}lineage-page{% endblock %}
{% block body_attributes %}style="--lineage-background: {{ style.background_color }}" {% endblock %}
{% block head %}
	<script src="https://unpkg.com/force-graph@1.52.0/dist/force-graph.min.js"></script>
	<script src="https://unpkg.com/three@0.160.0/build/three.min.js"></script>
	<script src="https://unpkg.com/3d-force-graph@1.77.0/dist/3d-force-graph.min.js"></script>
	<script src="https://unpkg.com/three-spritetext@1.10.0/dist/three-spritetext.min.js"></script>
{% endblock %}
{% block stylesheets %}
<link rel="stylesheet" href="{{ root_path or "" }}css/graph.css">
{% endblock %}
{% block page_context %}
<aside class="site-context" id="lineage-context" aria-label="Lineage context">
	{% include "graph/view_controls.html.j2" %}
	<button class="ui-button context-close" type="button" aria-label="Close lineage context">Close</button>
	{% block lineage_context %}{% endblock %}
</aside>
{% endblock %}
{% block content %}
<main class="lineage-workspace">
	<div class="lineage-stage">
		<button class="ui-button context-toggle" type="button" aria-label="Show lineage context"
			aria-expanded="false" aria-controls="lineage-context">Lineage controls</button>
		<p id="lineage-error" role="alert" hidden></p>
		<noscript><p class="lineage-error">JavaScript is required to display interactive lineage.</p></noscript>
		{% block body %}{% endblock %}
	</div>
</main>
{% endblock %}
{% block scripts %}
{{ super() }}
{% block lineage_script %}{% endblock %}
{% endblock %}
