{% extends "graph/base.html.j2" %}
{% from "graph/components.html.j2" import node_details_panel, graph_canvas, graph_legend %}
{% block title %}Feature lineage{% endblock %}
{% block body %}
	{% call graph_legend("Legend") %}
			<span class="function" style="--color:{{ style.function_color }}">Action</span>
			<span class="legend-heading">Datasets</span>
			<div class="dataset-legend" id="dataset-legend"></div>
	{% endcall %}
	{{ node_details_panel("details details-2d", "Selected item") }}
	{{ graph_canvas() }}
	<script id="graph-data" type="application/json">{{ graph_data|safe }}</script>
	<script id="graph-style" type="application/json">{{ graph_style_data|tojson }}</script>
{% endblock %}
{% block graph_script %}
<script src="{{ root_path or "" }}js/feature_lineage.js"></script>
{% endblock %}
