{% extends "graph/base.html.j2" %}
{% from "graph/components.html.j2" import node_details_panel, lineage_canvas, lineage_legend %}
{% block title %}Lineage{% endblock %}
{% block lineage_context %}
	{% call lineage_legend("Legend") %}
			<span class="function" style="--color:{{ style.function_color }}">Action</span>
			<span class="legend-heading">Datasets</span>
			<div class="dataset-legend" id="dataset-legend"></div>
	{% endcall %}
	{{ node_details_panel("details", "Selected item") }}
{% endblock %}
{% block body %}
	{{ lineage_canvas() }}
	<script id="graph-data" type="application/json">{{ graph_data|safe }}</script>
	<script id="graph-style" type="application/json">{{ graph_style_data|tojson }}</script>
{% endblock %}
{% block lineage_script %}
<script type="module" src="{{ root_path or "" }}js/feature_lineage.js"></script>
{% endblock %}
