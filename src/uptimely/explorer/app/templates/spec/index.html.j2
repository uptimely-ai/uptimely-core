{% extends "base.html.j2" %}
{% block title %}OpenAnalytics spec{% endblock %}
{% block stylesheets %}
<link rel="stylesheet" href="{{ root_path or "" }}css/spec.css">
{% endblock %}
{% block content %}
  <div class="model-grid pointer-events-none fixed inset-0 -z-0 opacity-30"></div>
  <div class="relative z-10 mx-auto max-w-7xl px-5 py-8 sm:px-8 lg:px-10">
    {% if generated_at %}<p class="mb-6 font-mono text-[10px] text-slate-500">generated {{ generated_at }}</p>{% endif %}
    <div>
      <main>
        {% block spec_sections %}
        {% include "spec/sections/overview.html.j2" %}
        {% include "spec/sections/entities.html.j2" %}
        {% include "spec/sections/dataset_list.html.j2" %}
        {% include "spec/sections/dimensions.html.j2" %}
        {% include "spec/sections/functions.html.j2" %}
        {% endblock %}
      </main>
    </div>
  </div>
{% endblock %}
