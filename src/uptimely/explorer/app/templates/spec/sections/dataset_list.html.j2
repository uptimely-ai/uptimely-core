{% from "spec/section_header.html.j2" import section_header with context %}
{% macro action_kind(action, functions) -%}
  {{- functions.get(action.binding.function, {}).get("kind", "") -}}
{%- endmacro %}
{% set column_colors = {
  "dimension": "bg-[#172b46] text-[#b5d4f8]",
  "teal": "bg-[#15352e] text-[#a5dfca]",
  "escape": "bg-[#30234a] text-[#d8b4fe]",
  "amber": "bg-[#392e19] text-[#efcf89]",
  "neutral": "bg-slate-800 text-slate-300"
} %}
<section id="datasets" class="mb-16">
  {{ section_header("Datasets", none) }}
  {% if has_catalog_context %}{% include "catalog_overview.html.j2" %}{% endif %}
  <div class="space-y-8">
    {% for entity_id, entity in configuration.entities.items() %}
      {% for dataset_id, dataset in entity.datasets.items() %}
      {% set schema = namespace(columns=[], producers={}) %}
      {% for action in dataset.actions.values() %}
        {% set kind = action_kind(action, configuration.functions) %}
        {% if kind == "escape" %}
          {% set color = "escape" %}
        {% elif kind in ["vectorize", "collapse"] %}
          {% set color = "amber" %}
        {% else %}
          {% set color = "teal" %}
        {% endif %}
        {% for feature_ref in action.features.outputs %}
          {% set feature_id = feature_ref.removeprefix("$features.") %}
          {% if feature_id not in schema.producers %}
            {% set _ = schema.producers.update({feature_id: color}) %}
          {% endif %}
        {% endfor %}
      {% endfor %}
      {% for dimension_id in entity.dimensions %}
        {% set dimension = configuration.dimensions[dimension_id] %}
        {% set _ = schema.columns.append({"name": dimension_id, "type": dimension.type, "role": "Dimension", "color": "dimension"}) %}
      {% endfor %}
      {% for feature_id, feature in dataset.features.items() if feature_id not in entity.dimensions %}
        {% set color = schema.producers.get(feature_id, "neutral") %}
        {% set _ = schema.columns.append({"name": feature_id, "type": feature.type or "unspecified", "unit": feature.unit, "role": "Raw" if color == "teal" else "External" if color == "escape" else "Feature", "color": color}) %}
      {% endfor %}
      {% set columns = schema.columns %}
      <article id="dataset-{{ dataset_id }}" data-context-item>
        <header class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <p class="font-mono text-[10px] uppercase tracking-wider text-slate-500">{{ entity.name or entity_id }}</p>
            {% set dataset_heading = "h2" %}
            <{{ dataset_heading }} class="mt-2 break-words font-display text-xl font-semibold text-white">{{ dataset_id }}</{{ dataset_heading }}>
          </div>
          <span class="rounded-full bg-slate-800/70 px-3 py-1 font-mono text-[10px] text-slate-400">{{ columns|length }} columns</span>
        </header>
        {% set ns = namespace(action_count=0) %}
        {% for action in dataset.actions.values() %}
          {% if action_kind(action, configuration.functions) != "vectorize" %}
            {% set ns.action_count = ns.action_count + 1 %}
          {% endif %}
        {% endfor %}
        {% if dataset.description or dataset.row_scope.get("filtering") or dataset.row_scope.get("coverage") or dataset.order or ns.action_count %}
        <section class="mt-5 border-t border-slate-800 pt-5" aria-label="Dataset details">
          <h3 class="font-display text-lg font-semibold text-white">Dataset details</h3>
          <div class="mt-5 space-y-6">
            {% if dataset.description %}<p class="max-w-3xl text-sm leading-6 text-slate-400">{{ dataset.description }}</p>{% endif %}
            {% if dataset.row_scope.get("filtering") or dataset.row_scope.get("coverage") %}
            <dl class="grid gap-6 sm:grid-cols-2">
              {% for label, key in [("Filtering", "filtering"), ("Coverage", "coverage")] %}
              {% if dataset.row_scope.get(key) %}
              <div><dt class="font-mono text-xs uppercase tracking-wider text-slate-400">{{ label }}</dt><dd class="mt-2 text-sm leading-6 text-slate-300">{{ dataset.row_scope[key] }}</dd></div>
              {% endif %}
              {% endfor %}
            </dl>
            {% endif %}
            {% if dataset.order %}
            <div>
              <h4 class="font-mono text-xs uppercase tracking-wider text-slate-400">Logical order</h4>
              <p class="mt-2 text-xs text-slate-500">Not a physical row-order guarantee.</p>
              <ul class="mt-2 flex flex-wrap gap-2">
                {% for key in dataset.order %}
                <li class="rounded-md bg-slate-800 px-2 py-1 font-mono text-xs text-slate-300">{{ key.dimension }} {{ key.direction }}</li>
                {% endfor %}
              </ul>
            </div>
            {% endif %}
            {% if ns.action_count %}
            <div>
              <h4 class="mb-3 font-mono text-xs uppercase tracking-wider text-slate-400">Actions</h4>
              <div class="divide-y divide-slate-800">
            {% for action_id, action in dataset.actions.items() if action_kind(action, configuration.functions) != "vectorize" %}
              <div class="space-y-2 py-3">
              <p class="font-mono text-sm text-slate-300">{{ action_kind(action, configuration.functions) }} · {{ action_id }}</p>
              {% if action_kind(action, configuration.functions) == "collapse" %}
              <div class="w-full font-mono text-xs text-slate-400">
                Input dataset inferred from bound features · Group by entity dimensions: {{ entity.dimensions | tojson }}
                <p>{{ action.binding.function }}({{ action.binding.args | tojson }})</p>
              </div>
              {% endif %}
              {% if action_kind(action, configuration.functions) == "escape" %}
              <p class="w-full text-xs leading-5 text-violet-300">External effects are uncontrolled. Declared inputs and outputs express logical dependencies only; escape outputs are not materialized as dataframe columns.</p>
              {% endif %}
              </div>
            {% endfor %}
              </div>
            </div>
            {% endif %}
          </div>
        </section>
        {% endif %}
        {% if dataset.row_scope and dataset.row_scope.get("grain") %}<p class="mt-3 max-w-3xl text-sm leading-6 text-slate-400">{{ dataset.row_scope.grain }}</p>{% endif %}
        {% if columns %}
        <div class="mt-6">
          <div class="dataset-table-scroll overflow-x-auto rounded-xl border border-slate-700/60">
            <table data-dataset-schema="{{ dataset_id }}" class="w-full min-w-max border-collapse text-left font-mono text-xs">
              <caption class="sr-only">Declared column types and units for {{ dataset_id }}; schema only, no sample records.</caption>
              <thead>
                <tr>
                  {% for column in columns %}
                  <th scope="col" class="border-b border-slate-700/50 px-4 py-4 {{ column_colors[column.color] }}">{{ column.name }}<span class="mt-2 block text-[10px] font-normal">{{ column.role }}</span></th>
                  {% endfor %}
                </tr>
              </thead>
              <tbody>
                <tr>
                  {% for column in columns %}
                  <td class="px-4 py-3 {{ column_colors[column.color] }}">{{ column.type }}{% if column.unit %} · {{ column.unit }}{% endif %}</td>
                  {% endfor %}
                </tr>
              </tbody>
            </table>
          </div>
        </div>
        {% endif %}
      </article>
      {% endfor %}
    {% endfor %}
  </div>
</section>
