{% from "spec/section_header.html.j2" import section_header with context %}
{% macro function_card(function_id, function, category=none) %}
<article class="rounded-2xl border border-slate-800 bg-slate-900/70 p-6">
  {% if category %}<p class="mb-2 font-mono text-[10px] uppercase tracking-wider text-cyan-300">{{ category }} function</p>{% endif %}
  <div class="flex items-start justify-between gap-4">
    <div>
      {% set function_heading = "h3" %}
      <{{ function_heading }} class="break-words font-display text-lg font-semibold text-white">{{ function_id }}</{{ function_heading }}>
      <p class="mt-2 text-xs text-lime-300">declared returns {{ function.declared_returns }}{% if function.signature_validation_disabled %} · Python signature validation disabled{% elif function.return_type %} · Python signature returns {{ function.return_type }}{% endif %}</p>
    </div>
  </div>
  <p class="mt-4 text-sm leading-6 text-slate-400">{{ function.description or "No description provided." }}</p>
  {% if function.doc and function.doc.body %}
  <p class="mt-2 text-sm leading-6 text-slate-400">{{ function.doc.body }}</p>
  {% endif %}
  {% if function.kind == "escape" %}
  <p class="mt-3 rounded-lg border border-violet-900/60 bg-violet-950/30 p-3 text-xs leading-5 text-violet-200">Uncontrolled external operation. Its Python return value is ignored; declared outputs are not verified or materialized as dataframe columns.</p>
  {% if function.escape_actions %}
  <div class="mt-4 space-y-3">
    <p class="font-mono text-[10px] uppercase tracking-wider text-slate-500">Declared feature boundaries</p>
    {% for action in function.escape_actions %}
    <div class="rounded-lg border border-slate-800 bg-slate-950/60 p-3 font-mono text-xs text-slate-300">
      <p>{{ action.entity }} / {{ action.dataset }} · {{ action.action }}</p>
      <p class="mt-1">Inputs: {{ action.inputs|join(", ") or "none" }}</p>
      <p>External outputs: {{ action.outputs|join(", ") or "none" }}</p>
    </div>
    {% endfor %}
  </div>
  {% endif %}
  {% endif %}
  {% if function.signature_validation_disabled %}
  <div class="mt-5 rounded-xl border border-slate-800 bg-slate-950/80 p-3 font-mono text-xs text-slate-200">
    <div class="mb-2 text-slate-500">Declared arguments</div>
    {% if function.args %}
      {% for argument_id, argument in function.args.items() %}
        <div><span class="text-cyan-200">{{ argument_id }}</span><span class="text-slate-500">: </span><span class="text-lime-300">{{ argument.type or "unspecified" }}</span></div>
      {% endfor %}
    {% else %}
      <div class="text-slate-400">None</div>
    {% endif %}
  </div>
  {% else %}
  <div class="mt-5 rounded-xl border border-slate-800 bg-slate-950/80 p-3 font-mono text-xs text-slate-200">
    <div class="text-slate-500">def <span class="text-white">{{ function_id }}</span>(</div>
    {% if function.args %}
      {% for argument_id, argument in function.args.items() %}
        <div class="pl-4"><span class="text-cyan-200">{{ argument_id }}</span><span class="text-slate-500">: </span><span class="text-lime-300">{{ argument.type or "unspecified" }}</span>{% if not loop.last %}<span class="text-slate-500">,</span>{% endif %}</div>
        {% if function.doc and function.doc.params.get(argument_id) %}
        <div class="whitespace-normal pl-8 font-sans text-[11px] leading-4 text-slate-500">{{ function.doc.params[argument_id] }}</div>
        {% endif %}
      {% endfor %}
    {% else %}
      <div class="pl-4 text-slate-400">pass</div>
    {% endif %}
    <div class="text-slate-500">)</div>
    {% if function.return_type %}<div class="mt-1 text-lime-300">-&gt; {{ function.return_type }}</div>{% endif %}
  </div>
  {% if function.doc %}
    {% if function.doc.returns %}
    <div class="mt-4">
      <p class="font-mono text-[10px] uppercase tracking-wider text-slate-500">Returns</p>
      <p class="mt-1 text-xs leading-5 text-slate-400">{{ function.doc.returns }}</p>
    </div>
    {% endif %}
    {% if function.doc.raises %}
    <div class="mt-4">
      <p class="font-mono text-[10px] uppercase tracking-wider text-slate-500">Raises</p>
      {% for error in function.doc.raises %}
      <p class="mt-1 text-xs leading-5 text-slate-400"><span class="font-mono text-amber-300">{{ error.type }}</span>{% if error.description %} — {{ error.description }}{% endif %}</p>
      {% endfor %}
    </div>
    {% endif %}
    {% if function.doc.examples %}
    <div class="mt-4">
      <p class="font-mono text-[10px] uppercase tracking-wider text-slate-500">Examples</p>
      {% for example in function.doc.examples %}
      <pre class="mt-2 overflow-x-auto rounded-lg border border-slate-800 bg-slate-950/80 p-3 font-mono text-[11px] leading-5 text-slate-300">{{ example }}</pre>
      {% endfor %}
    </div>
    {% endif %}
  {% endif %}
  {% endif %}
  {% if function.entrypoint %}
    <div class="mt-5 border-t border-slate-800 pt-4">
      <p class="font-mono text-[10px] uppercase tracking-[.16em] text-slate-500">source</p>
      <a href="{{ function.entrypoint_file or function.entrypoint }}" class="mt-2 flex min-w-0 items-center gap-2 font-mono text-xs text-cyan-200 transition hover:text-cyan-100" target="_blank" rel="noreferrer">
        <i data-lucide="external-link" class="h-3.5 w-3.5 shrink-0" aria-hidden="true"></i>
        <span class="truncate">{{ function.entrypoint }}</span>
      </a>
    </div>
  {% endif %}
</article>
{% endmacro %}
<section id="functions" class="mb-16">
  {{ section_header("Functions", "Browse the function catalog, argument types, return signatures, and source entrypoints.", count=summary.function_count, count_label="functions") }}
  {% for group_name, group in function_groups.items() %}
    {% set ordered_functions = group.items() | list %}
    {% if ordered_functions %}
      <div class="mb-8">
        {% set group_icons = {"read": "database", "write": "send", "escape": "arrow-up-right", "vectorize": "wand-sparkles", "collapse": "combine", "expand": "expand", "conform": "shuffle"} %}
        <div data-function-group="{{ group_name }}" class="mb-4 flex items-center justify-between gap-4 rounded-2xl border border-cyan-900/60 bg-gradient-to-r from-slate-900 via-slate-900 to-cyan-950/50 px-4 py-3 shadow-lg shadow-cyan-950/10">
          <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl border border-cyan-800/70 bg-cyan-950/60 text-cyan-300">
              <i data-lucide="{{ group_icons.get(group_name, 'braces') }}" class="h-5 w-5" aria-hidden="true"></i>
            </span>
            <div>
              {% set group_heading = "h2" %}
              <{{ group_heading }} class="font-display text-xl font-semibold tracking-tight text-white">{{ group_name|title }}</{{ group_heading }}>
              <p class="mt-0.5 text-xs text-slate-400">{{ "Functions wrapped in grouping by the target entity dimensions" if group_name == "collapse" else "Uncontrolled operations with external effects" if group_name == "escape" else "Function group" }}</p>
            </div>
          </div>
          <span class="rounded-full border border-slate-700 bg-slate-950/70 px-3 py-1 font-mono text-[10px] uppercase tracking-wider text-cyan-200">{{ ordered_functions|length }} functions</span>
        </div>
        <div class="grid gap-5 lg:grid-cols-2">
          {% for function_id, function in ordered_functions %}
            {{ function_card(function_id, function, "Collapse" if group_name == "collapse" else none) }}
          {% endfor %}
        </div>
      </div>
    {% endif %}
  {% endfor %}
</section>
