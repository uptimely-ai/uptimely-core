{% from "spec/section_header.html.j2" import section_header with context %}
{% from "spec/function_kinds.html.j2" import kind_meta %}
{% from "icons.html.j2" import icon %}
{% set total = namespace(feature_count=0) %}
{% for entity in configuration.entities.values() %}
  {% for dataset in entity.datasets.values() %}
    {% set features = {} %}
    {% for action in dataset.actions.values() %}
      {% for reference in action.features.outputs %}
        {% set feature_id = reference.removeprefix("$features.") %}
        {% if feature_id not in entity.dimensions %}{% set _ = features.update({feature_id: true}) %}{% endif %}
      {% endfor %}
    {% endfor %}
    {% set total.feature_count = total.feature_count + features|length %}
  {% endfor %}
{% endfor %}
<section id="entities" class="mb-16">
  {{ section_header("Features", "", count=total.feature_count, count_label="features") }}
  {% if has_catalog_context %}{% include "catalog_overview.html.j2" %}{% endif %}
  <div class="space-y-5">
    {% for entity_id, entity in configuration.entities.items() %}
      {% for dataset_id, dataset in entity.datasets.items() %}
        {% set features = {} %}
        {% for action_id, action in dataset.actions.items() %}
          {% for reference in action.features.outputs %}
            {% set feature_id = reference.removeprefix("$features.") %}
            {% if feature_id not in entity.dimensions %}
              {% set _ = features.update({feature_id: {"action_id": action_id, "action": action}}) %}
            {% endif %}
          {% endfor %}
        {% endfor %}
        {% for feature_id, producer in features.items() %}
          {% set feature = dataset.features[feature_id] %}
          {% set function = configuration.functions.get(producer.action.binding.function, {}) %}
          {% set function_kind = function.get("kind", "") %}
          {% set function_kind_meta = kind_meta.get(function_kind, {"icon": "braces", "label": function_kind|title}) %}
          <article id="feature-{{ dataset_id }}-{{ feature_id }}" data-context-item>
            <h2 class="font-display text-2xl font-semibold text-white">{{ feature_id }}</h2>
            <p data-feature-description class="mt-4 text-sm leading-6 text-slate-400">{{ feature.description or "No description provided." }}</p>
            <section class="mt-6 rounded-xl border border-cyan-900/60 bg-cyan-950/20 p-4 sm:p-5">
              <h3 class="flex items-center gap-2 font-mono text-xs font-semibold uppercase tracking-[.14em] text-cyan-200">
                {{ icon("functions", "h-4 w-4") }}Produced by {{ producer.action.binding.function }}
              </h3>
              <p class="mt-3 flex items-center gap-2 text-xs text-slate-400">
                <i data-lucide="{{ function_kind_meta.icon }}" class="site-icon icon--functions h-3.5 w-3.5 text-cyan-300" aria-hidden="true"></i>
                <span class="font-mono text-cyan-100">{{ function_kind_meta.label or "Unspecified" }}</span>
              </p>
              <p class="mt-3 text-sm leading-6 text-slate-300">{{ function.get("description") or "No description provided." }}</p>
            </section>
            <dl class="mt-6 grid gap-6 sm:grid-cols-2">
              {% for label, value in [
                ("Entity", entity.name or entity_id),
                ("Dataset", dataset.name or dataset_id),
                ("Type", feature.type or "unspecified"),
                ("Unit", feature.unit or "Not specified")
              ] %}
              {% set icon_key = {"Entity": "entities", "Dataset": "datasets", "Type": "features", "Unit": "dimensions"}[label] %}
              <div>
                <dt class="flex items-center gap-2 text-xs text-slate-500">{{ icon(icon_key, "h-3.5 w-3.5") }}{{ label }}</dt>
                <dd class="mt-2 break-words font-mono text-sm text-slate-300">{{ value }}</dd>
              </div>
              {% endfor %}
            </dl>
            {% if function_kind == "escape" %}
            <p class="mt-6 text-sm leading-6 text-violet-300">Declared logical output only; escape outputs are not materialized as dataframe columns.</p>
            {% endif %}
          </article>
        {% endfor %}
      {% endfor %}
    {% endfor %}
  </div>
</section>
