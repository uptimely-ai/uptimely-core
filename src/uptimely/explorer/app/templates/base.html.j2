{% from "icons.html.j2" import icon %}
{% from "project_context.html.j2" import project_link, build_badge %}
<!DOCTYPE html>
<html lang="en" class="bg-slate-950{% if include_navigation %} with-navigation{% endif %}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Analytics Explorer{% endblock %}</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="{{ root_path or "" }}js/tailwind_config.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@500&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
  {% block head %}{% endblock %}
  <link rel="stylesheet" href="{{ root_path or "" }}css/base.css">
  <link rel="stylesheet" href="{{ root_path or "" }}css/icons.css">
  {% block stylesheets %}{% endblock %}
</head>
<body {% block body_attributes %}{% endblock %}class="{% block body_class %}min-h-screen bg-slate-950 font-sans text-slate-200{% endblock %}">
  {% set rel_root = root_path or "" %}
  {% include "top_bar.html.j2" %}
  {% if include_navigation %}
  <nav class="site-nav" id="explorer-navigation" aria-label="Explorer pages">
    <div class="site-nav-context">
      <div class="site-nav-heading">
        {{ project_link(rel_root, index_filename, project_name, active_page) }}
        <button class="nav-label-toggle" type="button" aria-label="Hide navigation labels"
          aria-pressed="false" aria-controls="explorer-navigation" title="Hide navigation labels">
          {{ icon("collapse-navigation", "nav-icon") }}{{ icon("expand-navigation", "nav-icon") }}
        </button>
      </div>
    </div>
    <div class="site-nav-pages">
    {% for page, label, icon_key in [("spec", "Spec", "spec"), ("plan", "Plan", "plan"), ("execution", "Execution", "execution")] %}
    <a aria-label="{{ label }}" title="{{ label }}" href="{{ rel_root }}{{ website_pages[page]['data_lineage' if page == 'execution' else 'overview'] }}"{% if active_page == page and not active_section %} aria-current="page"{% endif %}>{{ icon(icon_key, "nav-icon") }}<span>{{ label }}</span></a>
    {% if page == "spec" %}
    <div class="site-subnav" role="group" aria-label="Spec sections">
      {% for section, section_label, section_icon in [
        ("overview", "Overview", "overview"),
        ("features", "Features", "features"),
        ("entities", "Entities", "entities"),
        ("datasets", "Datasets", "datasets"),
        ("dimensions", "Dimensions", "dimensions"),
        ("functions", "Functions", "functions"),
        ("feature_lineage", "Feature lineage", "feature-lineage")
      ] %}
      <a aria-label="{{ section_label }}" title="{{ section_label }}" href="{{ rel_root }}{{ website_pages["spec"][section] }}"{% if active_page == "spec" and active_section == section %} aria-current="page"{% endif %}>{{ icon(section_icon, "nav-icon") }}<span>{{ section_label }}</span></a>
      {% endfor %}
    </div>
    {% elif page == "plan" %}
    <div class="site-subnav" role="group" aria-label="Plan sections">
      {% for section, section_label, section_icon in [
        ("overview", "Overview", "overview"),
        ("invocation_lineage", "Invocation lineage", "invocation-lineage"),
        ("stages", "Stages", "stages")
      ] %}
      <a aria-label="{{ section_label }}" title="{{ section_label }}" href="{{ rel_root }}{{ website_pages['plan'][section] }}"{% if active_page == "plan" and active_section == section %} aria-current="page"{% endif %}>{{ icon(section_icon, "nav-icon") }}<span>{{ section_label }}</span></a>
      {% endfor %}
    </div>
    {% elif page == "execution" %}
    <div class="site-subnav" role="group" aria-label="Execution sections">
      <a aria-label="Data lineage" title="Data lineage" href="{{ rel_root }}{{ website_pages['execution']['data_lineage'] }}"{% if active_page == "execution" and active_section == "data_lineage" %} aria-current="page"{% endif %}>{{ icon("data-lineage", "nav-icon") }}<span>Data lineage</span></a>
    </div>
    {% endif %}
    {% endfor %}
    </div>
    {{ build_badge(is_scoped, execution_scope) }}
  </nav>
  {% endif %}
  {% block page_context %}{% endblock %}
  <div class="site-content">
    {% block content %}{% endblock %}
  </div>
  {% block scripts %}
  <script src="https://unpkg.com/lucide@latest"></script><script src="{{ root_path or "" }}js/icons.js"></script>
  {% endblock %}
</body>
</html>
