<section id="dimensions" class="mb-16">
  <div class="mb-6"><h2 class="flex items-center gap-3 font-display text-3xl font-semibold text-white"><i data-lucide="layers-3" class="h-7 w-7 shrink-0 text-rose-300" aria-hidden="true"></i>Dimensions</h2></div>
  <div class="grid gap-5 md:grid-cols-2">{% for dimension_id, dimension in configuration.dimensions.items() %}<article class="overflow-hidden rounded-2xl border border-slate-800 bg-slate-900/70 p-6"><div class="flex items-start justify-between gap-4"><div><p class="font-mono text-[10px] uppercase tracking-[.18em] text-rose-300">dimension</p><h3 class="mt-2 font-display text-2xl font-semibold text-white">{{ dimension_id }}</h3></div><div class="flex h-10 w-10 items-center justify-center rounded-xl bg-rose-300/10 text-rose-300"><i data-lucide="layers-3" class="h-5 w-5"></i></div></div><div class="mt-6 flex flex-wrap gap-2"><span class="rounded-md bg-rose-300/10 px-2.5 py-1 font-mono text-xs text-rose-200">{{ dimension.type }}</span>{% if dimension.parent %}<span class="rounded-md bg-slate-800 px-2.5 py-1 font-mono text-xs text-slate-300">child of {{ dimension.parent }}</span>{% endif %}</div><p class="mt-5 min-h-12 text-sm leading-6 text-slate-400">{{ dimension.description or "No description provided." }}</p></article>{% endfor %}</div>
</section>
