{% extends "base.html.j2" %}
{% block title %}Execution / Data lineage{% endblock %}
{% block style %}
  .lineage-page { padding: 24px; }
  .lineage-page h1 { font: 600 30px "Space Grotesk", sans-serif; color: #f8fafc; }
  .lineage-page p { color: #94a3b8; line-height: 1.7; }
  .lineage-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 16px 0; font-size: 12px; }
  .lineage-toolbar button { padding: 6px 10px; border: 1px solid #334155; border-radius: 6px;
    background: #0f172a; color: #cbd5e1; cursor: pointer; }
  .lineage-toolbar button:focus-visible { outline: 2px solid #c4b5fd; outline-offset: 2px; }
  .lineage-toolbar output { min-width: 48px; text-align: center; color: #94a3b8; }
  .lineage-toolbar[hidden] { display: none; }
  .lineage-scroll { overflow: auto; height: 65vh; border: 1px solid #334155; border-radius: 12px; background: #020617; }
  .lineage-scroll:focus-visible, .lineage-table-scroll:focus-visible { outline: 2px solid #c4b5fd; outline-offset: 2px; }
  .lineage-canvas { position: relative; }
  .lineage-board { position: relative; display: flex; align-items: flex-start; gap: 64px; width: max-content; padding: 64px 24px 24px; transform-origin: top left; }
  .lineage-board-scaled { position: absolute; top: 0; left: 0; }
  .lineage-stage { position: relative; width: 320px; flex-shrink: 0; z-index: 1; }
  .lineage-stage h2 { margin: 0 0 12px; color: #94a3b8; font: 11px "JetBrains Mono", monospace; }
  .lineage-step { margin-bottom: 16px; padding: 10px; border: 1px solid var(--step-color);
    border-top: 3px solid var(--step-color); border-radius: 8px; background: #0f172a; }
  .lineage-step h3 { margin: 4px 0; color: var(--step-color); font: 600 13px "Space Grotesk", sans-serif; overflow-wrap: anywhere; }
  .lineage-step p { margin: 4px 0; font-size: 11px; overflow-wrap: anywhere; }
  .lineage-step details { margin-top: 6px; font-size: 11px; color: #94a3b8; }
  .lineage-step summary { cursor: pointer; }
  .lineage-step .step-kind { font: 10px "JetBrains Mono", monospace; text-transform: uppercase; color: var(--step-color); }
  .lineage-table-scroll { overflow-x: auto; margin: 8px 0; }
  .lineage-table { width: 100%; border-collapse: collapse; font: 10px "JetBrains Mono", monospace; }
  .lineage-table caption { text-align: left; color: #94a3b8; margin-bottom: 4px; font: 10px "DM Sans", sans-serif; }
  .lineage-table th, .lineage-table td { padding: 5px 6px; border: 1px solid #334155; text-align: left; white-space: nowrap; }
  .lineage-table .column-cell { color: var(--column-color); background: color-mix(in srgb, var(--column-color) 12%, #0f172a); }
  .lineage-table .column-role { display: block; margin-bottom: 3px; font: 9px "DM Sans", sans-serif; text-transform: uppercase; }
  .lineage-dependencies { font-size: 10px; color: #94a3b8; }
  .lineage-dependencies a { color: #c4b5fd; text-decoration: underline; }
  .lineage-edges { position: absolute; inset: 0; pointer-events: none; }
  @media (max-width: 640px) { .lineage-page { padding: 20px 12px; } }
{% endblock %}
{% block content %}
<main class="lineage-page">
  <p class="font-mono text-xs uppercase tracking-widest">Execution</p>
  <h1 class="title-with-icon">{{ icon("lineage", "title-icon") }}<span>Data lineage</span></h1>
  <p>Follow data through the processing steps, from source columns to calculated features and writes.
    Tables show declared column types, not runtime values. Building this website does not execute analytics.</p>
  {% if stages %}
  <p>Scroll to explore stages from left to right. Steps in the same stage are independent.
    Each table labels input and output columns separately; these are logical column flows, not stored table snapshots.</p>
  <div class="lineage-toolbar" id="lineage-toolbar" role="group" aria-label="Data lineage zoom" hidden>
    <button type="button" id="lineage-zoom-out" aria-label="Zoom out">-</button>
    <output id="lineage-zoom-level" aria-live="polite">75%</output>
    <button type="button" id="lineage-zoom-in" aria-label="Zoom in">+</button>
    <button type="button" id="lineage-fit">Fit view</button>
    <button type="button" id="lineage-reset">100%</button>
  </div>
  <div class="lineage-scroll" tabindex="0" role="region" aria-label="Processing tables and dependency edges">
    <div class="lineage-canvas" id="lineage-canvas">
    <div class="lineage-board" id="lineage-board">
      <svg class="lineage-edges" id="lineage-edges" aria-hidden="true"></svg>
      {% for stage in stages %}
      <section class="lineage-stage" aria-labelledby="stage-{{ loop.index }}">
        <h2 id="stage-{{ loop.index }}">Stage {{ loop.index }} / {{ stage|length }} step{% if stage|length != 1 %}s{% endif %}</h2>
        {% for step in stage %}
        <article class="lineage-step" id="step-{{ step.number }}" data-operation="{{ step.operation_id }}"
          data-dependencies="{{ step.dependencies|join(',') }}" style="--step-color: {{ step.color }}">
          <span class="step-kind">Step {{ step.number }} / {{ step.kind }}</span>
          <h3>{{ step.function }}</h3>
          <details>
            <summary>Dataset details</summary>
            <p>Entity: {{ step.entity }}<br>Dataset: {{ step.dataset or "None" }}</p>
            {% if step.grain %}<p>Grain: {{ step.grain }}</p>{% endif %}
            {% if step.kind == "write" %}<p>Write boundary: consumes columns; produces no analytical features.</p>{% endif %}
          </details>
          {% if step.columns %}
          <div class="lineage-table-scroll" tabindex="0" role="region" aria-label="Step {{ step.number }} columns">
            <table class="lineage-table">
              <caption>Step {{ step.number }} column flow</caption>
              <thead><tr><th scope="col">Column</th>
                {% for column in step.columns %}
                <th scope="col" class="column-cell" data-column="{{ column.name }}" data-role="{{ column.role }}" style="--column-color: {{ column.color }}">
                  <span class="column-role">{{ column.role }}</span>{{ column.name }}
                </th>
                {% endfor %}
              </tr></thead>
              <tbody>
                <tr><th scope="row">Type</th>{% for column in step.columns %}<td class="column-cell" style="--column-color: {{ column.color }}">{{ column.type }}</td>{% endfor %}</tr>
                <tr><th scope="row">Producer</th>{% for column in step.columns %}<td class="column-cell" style="--column-color: {{ column.color }}">{% if column.producer %}Step {{ column.producer }}{% elif column.role == "Dimension" %}Observation key{% else %}No declared producer{% endif %}</td>{% endfor %}</tr>
              </tbody>
            </table>
          </div>
          {% else %}<p>No declared columns.</p>{% endif %}
          <div class="lineage-dependencies">Depends on:
            {% for dependency in step.dependencies %}<a href="#step-{{ dependency }}">Step {{ dependency }}</a>{% if not loop.last %}, {% endif %}{% else %}Source step{% endfor %}
          </div>
        </article>
        {% endfor %}
      </section>
      {% endfor %}
    </div>
    </div>
  </div>
  <noscript><p>Dependency arrows need JavaScript. The tables and their dependency links remain available above.</p></noscript>
  {% else %}
  <p>No processing steps. Add function mappings to the specification to display data lineage.</p>
  {% endif %}
</main>
{% endblock %}
{% block scripts %}
{{ super() }}
<script>
(() => {
  const board = document.getElementById("lineage-board");
  if (!board) return;
  const svg = document.getElementById("lineage-edges");
  const namespace = "http://www.w3.org/2000/svg";
  const edgeColor = "#94a3b8";
  const steps = Array.from(board.querySelectorAll(".lineage-step"));
  const canvas = document.getElementById("lineage-canvas");
  const viewport = canvas.parentElement;
  const toolbar = document.getElementById("lineage-toolbar");
  const zoomLevel = document.getElementById("lineage-zoom-level");
  let zoom = 0.75;
  let fitted = false;
  function setZoom(value) {
    zoom = Math.min(1.5, Math.max(0.01, value));
    board.classList.add("lineage-board-scaled");
    board.style.transform = `scale(${zoom})`;
    canvas.style.width = `${board.offsetWidth * zoom}px`;
    canvas.style.height = `${board.offsetHeight * zoom}px`;
    zoomLevel.value = `${Math.round(zoom * 100)}%`;
    drawEdges();
  }
  function fitView() {
    fitted = true;
    setZoom(Math.min(
      (viewport.clientWidth - 24) / board.offsetWidth,
      (viewport.clientHeight - 24) / board.offsetHeight,
      1
    ));
    viewport.scrollTo(0, 0);
  }
  function changeZoom(value) {
    const centerX = (viewport.scrollLeft + viewport.clientWidth / 2) / zoom;
    const centerY = (viewport.scrollTop + viewport.clientHeight / 2) / zoom;
    fitted = false;
    setZoom(value);
    viewport.scrollTo(
      centerX * zoom - viewport.clientWidth / 2,
      centerY * zoom - viewport.clientHeight / 2
    );
  }
  document.getElementById("lineage-zoom-out").addEventListener("click", () => changeZoom(zoom - 0.1));
  document.getElementById("lineage-zoom-in").addEventListener("click", () => changeZoom(zoom + 0.1));
  document.getElementById("lineage-fit").addEventListener("click", fitView);
  document.getElementById("lineage-reset").addEventListener("click", () => changeZoom(1));
  toolbar.hidden = false;
  function drawEdges() {
    const bounds = board.getBoundingClientRect();
    svg.setAttribute("width", board.offsetWidth);
    svg.setAttribute("height", board.offsetHeight);
    svg.replaceChildren();
    const definitions = document.createElementNS(namespace, "defs");
    const marker = document.createElementNS(namespace, "marker");
    marker.setAttribute("id", "lineage-arrow");
    marker.setAttribute("viewBox", "0 0 10 10");
    marker.setAttribute("refX", "9");
    marker.setAttribute("refY", "5");
    marker.setAttribute("markerWidth", "6");
    marker.setAttribute("markerHeight", "6");
    marker.setAttribute("orient", "auto");
    const arrow = document.createElementNS(namespace, "path");
    arrow.setAttribute("d", "M 0 0 L 10 5 L 0 10 z");
    arrow.setAttribute("fill", edgeColor);
    marker.append(arrow);
    definitions.append(marker);
    svg.append(definitions);
    steps.forEach(target => {
      const targetBounds = target.getBoundingClientRect();
      target.dataset.dependencies.split(",").filter(Boolean).forEach(number => {
        const source = document.getElementById(`step-${number}`);
        const sourceBounds = source.getBoundingClientRect();
        const x1 = (sourceBounds.right - bounds.left) / zoom;
        const y1 = (sourceBounds.top - bounds.top) / zoom + 20;
        const x2 = (targetBounds.left - bounds.left) / zoom;
        const y2 = (targetBounds.top - bounds.top) / zoom + 20;
        const path = document.createElementNS(namespace, "path");
        const skipsStage = x2 - x1 > 65;
        const routeY = 16 + (Number(number) % 4) * 10;
        path.setAttribute("d", skipsStage
          ? `M ${x1} ${y1} C ${x1 + 30} ${y1}, ${x1 + 30} ${routeY}, ${x1 + 45} ${routeY} L ${x2 - 45} ${routeY} C ${x2 - 30} ${routeY}, ${x2 - 30} ${y2}, ${x2} ${y2}`
          : `M ${x1} ${y1} C ${x1 + 45} ${y1}, ${x2 - 45} ${y2}, ${x2} ${y2}`);
        path.setAttribute("stroke", edgeColor);
        path.setAttribute("stroke-width", "2");
        path.setAttribute("fill", "none");
        path.setAttribute("marker-end", "url(#lineage-arrow)");
        path.setAttribute("data-source", source.id);
        path.setAttribute("data-target", target.id);
        svg.append(path);
      });
    });
  }
  function updateView() {
    if (fitted) fitView();
    else setZoom(zoom);
  }
  const observer = new ResizeObserver(updateView);
  observer.observe(board);
  observer.observe(viewport);
  board.addEventListener("toggle", updateView, true);
  document.fonts.ready.then(updateView);
  setZoom(zoom);
})();
</script>
{% endblock %}
