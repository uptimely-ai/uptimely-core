{% from "spec/section_header.html.j2" import section_header with context %}
{% set total = namespace(feature_count=0) %}
{% for entity in configuration.entities.values() %}
  {% for dataset in entity.datasets %}
    {% set total.feature_count = total.feature_count + dataset.vectorize|length %}
    {% for operation_type in ["read", "conform", "expand", "collapse"] %}
      {% for fragment in dataset.get(operation_type, {}).values() %}
        {% for feature_id in fragment.features %}
          {% if feature_id not in entity.dimensions %}{% set total.feature_count = total.feature_count + 1 %}{% endif %}
        {% endfor %}
      {% endfor %}
    {% endfor %}
  {% endfor %}
{% endfor %}
<section id="entities" class="mb-16">
  {{ section_header("Features", "Browse features by dataset and see which fragment provides each one.", count=total.feature_count, count_label="features") }}
  <div class="space-y-5">
    {% for entity_id, entity in configuration.entities.items() %}
      {% for dataset in entity.datasets %}
      <section>
        <header class="mb-3 flex flex-wrap items-end justify-between gap-3">
          <div>
            <p class="font-mono text-xs text-slate-400"><span class="uppercase tracking-wider text-slate-500">Entity:</span> {{ entity.name or entity_id }}</p>
            {% set dataset_heading = "h2" if include_navigation else "h3" %}
            <{{ dataset_heading }} class="mt-2 font-display text-xl font-semibold tracking-tight text-cyan-100">
              <span class="mr-2 font-mono text-[10px] font-medium uppercase tracking-wider text-cyan-400">Dataset name:</span>{{ dataset.id }}
            </{{ dataset_heading }}>
          </div>
          {% set ns = namespace(feature_count=dataset.vectorize|length) %}
          {% for operation_type in ["read", "conform", "expand", "collapse"] %}
            {% for fragment in dataset.get(operation_type, {}).values() %}
              {% for feature_id in fragment.features %}
                {% if feature_id not in entity.dimensions %}{% set ns.feature_count = ns.feature_count + 1 %}{% endif %}
              {% endfor %}
            {% endfor %}
          {% endfor %}
        </header>
        <article class="rounded-xl border border-slate-800 border-l-4 border-l-cyan-500 bg-slate-900/70 px-5">
          <p class="border-b border-slate-800 py-3 font-mono text-xs text-slate-400">{{ ns.feature_count }} features</p>
          <div class="divide-y divide-slate-800">
          {% for operation_type in ["read", "conform", "expand", "collapse"] %}
            {% for fragment_id, fragment in dataset.get(operation_type, {}).items() %}
              {% for feature_id, feature in fragment.features.items() if feature_id not in entity.dimensions %}
              <div class="grid gap-1 py-2 sm:grid-cols-[minmax(0,1fr)_minmax(8rem,1fr)] sm:gap-4">
                <div>
                  <span class="font-mono text-sm text-cyan-200">{{ feature_id }}</span>
                  {% if feature.description %}<p class="mt-0.5 text-xs text-slate-500">{{ feature.description }}</p>{% endif %}
                </div>
                <div class="flex flex-wrap items-center justify-between gap-2 sm:justify-end">
                  <span class="font-mono text-xs text-slate-400">{{ operation_type }} · {{ fragment_id }}</span>
                  <span class="text-xs text-slate-500">{{ feature.type or "unspecified" }}{% if feature.unit %} / {{ feature.unit }}{% endif %}</span>
                </div>
              </div>
              {% endfor %}
            {% endfor %}
          {% endfor %}
          {% for feature_id, feature in dataset.vectorize.items() %}
          <div class="grid gap-1 py-2 sm:grid-cols-[minmax(0,1fr)_minmax(8rem,1fr)] sm:gap-4">
            <div>
              <span class="font-mono text-sm text-amber-200">{{ feature_id }}</span>
              {% if feature.description %}<p class="mt-0.5 text-xs text-slate-500">{{ feature.description }}</p>{% endif %}
            </div>
            <div class="flex flex-wrap items-center justify-between gap-2 sm:justify-end">
              <span class="font-mono text-xs text-slate-400">vectorize · {{ feature_id }}</span>
              <span class="text-xs text-slate-500">{{ feature.type or "calculated" }}{% if feature.unit %} / {{ feature.unit }}{% endif %}</span>
            </div>
          </div>
          {% endfor %}
          </div>
        </article>
      </section>
      {% endfor %}
    {% endfor %}
  </div>
</section>
