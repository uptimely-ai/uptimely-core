{% from "spec/section_header.html.j2" import section_header with context %}
<section id="dimensions" class="mb-16">
  {{ section_header("Dimensions", "Inspect the dimensions that define data grain and their parent relationships.", count=summary.dimension_count, count_label="dimensions") }}
  <div class="grid gap-5 md:grid-cols-2">
    {% for dimension_id, dimension in configuration.dimensions.items() %}
    <article class="overflow-hidden rounded-2xl border border-slate-800 bg-slate-900/70 p-6">
      {% set heading = "h2" if include_navigation else "h3" %}
      <{{ heading }} class="break-words font-display text-lg font-semibold text-white">{{ dimension_id }}</{{ heading }}>
      <div class="mt-3 flex flex-wrap gap-2">
        <span class="rounded-md bg-slate-800 px-2.5 py-1 font-mono text-xs text-cyan-200">{{ dimension.type }}</span>
        {% if dimension.parent %}<span class="rounded-md bg-slate-800 px-2.5 py-1 font-mono text-xs text-slate-300">child of {{ dimension.parent }}</span>{% endif %}
      </div>
      <p class="mt-4 text-sm leading-6 text-slate-400">{{ dimension.description or "No description provided." }}</p>
    </article>
    {% endfor %}
  </div>
</section>
