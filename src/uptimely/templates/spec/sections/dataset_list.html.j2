{% from "spec/section_header.html.j2" import section_header with context %}
<section id="datasets" class="mb-16">
  {{ section_header("Datasets", "Inspect each dataset's row scope, logical order, and producing fragments.", count=summary.dataset_count, count_label="datasets") }}
  <div class="space-y-4">
    {% for entity_id, entity in configuration.entities.items() %}
      {% for dataset in entity.datasets %}
      <article class="rounded-xl border border-slate-800 bg-slate-900/70 p-5">
        <header class="flex flex-wrap items-baseline justify-between gap-3 border-b border-slate-800 pb-3">
          <div>
            <p class="font-mono text-[10px] uppercase tracking-wider text-slate-500">{{ entity.name or entity_id }}</p>
            {% set dataset_heading = "h2" if include_navigation else "h3" %}
            <{{ dataset_heading }} class="mt-1 font-display text-lg font-semibold text-white">{{ dataset.id }}</{{ dataset_heading }}>
          </div>
          <span class="font-mono text-xs text-slate-400">{{ dataset.vectorize|length }} calculated features</span>
        </header>
        {% if dataset.description %}<p class="mt-3 text-sm leading-6 text-slate-400">{{ dataset.description }}</p>{% endif %}
        {% if dataset.row_scope %}
        <dl class="mt-4 grid gap-3 sm:grid-cols-3">
          {% for label, key in [("Grain", "grain"), ("Filtering", "filtering"), ("Coverage", "coverage")] %}
          {% if dataset.row_scope.get(key) %}
          <div>
            <dt class="font-mono text-[10px] uppercase tracking-wider text-slate-500">{{ label }}</dt>
            <dd class="mt-1 text-sm text-slate-300">{{ dataset.row_scope[key] }}</dd>
          </div>
          {% endif %}
          {% endfor %}
        </dl>
        {% endif %}
        {% if dataset.order %}
        <div class="mt-4">
          <p class="font-mono text-[10px] uppercase tracking-wider text-slate-500">Logical order</p>
          <ul class="mt-1 flex flex-wrap gap-2">
            {% for key in dataset.order %}
            <li class="rounded-md bg-slate-800 px-2 py-1 font-mono text-xs text-slate-300">{{ key.dimension }} {{ key.direction }}</li>
            {% endfor %}
          </ul>
        </div>
        {% endif %}
        {% set ns = namespace(fragment_count=0) %}
        {% for operation_type in ["read", "conform", "expand", "collapse"] %}
          {% set ns.fragment_count = ns.fragment_count + dataset.get(operation_type, {})|length %}
        {% endfor %}
        <div class="mt-4 border-t border-slate-800 pt-3">
          <p class="mb-2 font-mono text-[10px] uppercase tracking-wider text-slate-500">{{ ns.fragment_count }} fragments</p>
          <div class="flex flex-wrap gap-2">
            {% for operation_type in ["read", "conform", "expand", "collapse"] %}
              {% for fragment_id in dataset.get(operation_type, {}) %}
              <span class="rounded-md bg-slate-800 px-2 py-1 font-mono text-xs text-slate-300">{{ operation_type }} · {{ fragment_id }}</span>
              {% endfor %}
            {% endfor %}
          </div>
        </div>
      </article>
      {% endfor %}
    {% endfor %}
  </div>
</section>
