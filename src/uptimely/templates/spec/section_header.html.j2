{% macro section_header(title, description, standalone_title=false, count=none, count_label="") %}
<header class="mb-8 border-b border-slate-800 pb-6">
  <p class="mb-3 font-mono text-[10px] uppercase tracking-[.18em] text-slate-500">Specification reference</p>
  <div class="flex flex-wrap items-center gap-3">
    {% if include_navigation or standalone_title %}
    <h1 class="font-display text-3xl font-semibold tracking-tight text-white">{{ title }}</h1>
    {% else %}
    <h2 class="font-display text-3xl font-semibold tracking-tight text-white">{{ title }}</h2>
    {% endif %}
    {% if count is not none %}
    <span class="rounded-md border border-slate-700 bg-slate-900 px-2.5 py-1 font-mono text-xs text-slate-400">{{ count }} {{ count_label }}</span>
    {% endif %}
  </div>
  <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-400">{{ description }}</p>
</header>
{% endmacro %}
