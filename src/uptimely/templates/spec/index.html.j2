{% extends "base.html.j2" %}
{% block title %}OpenAnalytics specification{% endblock %}
{% block content %}
  <div class="pointer-events-none fixed inset-0 -z-0 opacity-30" style="background-image: linear-gradient(rgba(51,65,85,.22) 1px, transparent 1px), linear-gradient(90deg, rgba(51,65,85,.22) 1px, transparent 1px); background-size: 48px 48px;"></div>
  <div class="relative z-10 mx-auto max-w-7xl px-5 py-8 sm:px-8 lg:px-10">
    <div class="mb-6 flex flex-wrap items-center gap-3 font-mono text-[10px] text-slate-500"><span class="rounded-md border border-slate-800 px-2 py-1">OpenAnalytics {{ configuration.version }}</span>{% if generated_at %}<span>generated {{ generated_at }}</span>{% endif %}</div>
    <div{% if not include_navigation %} class="lg:grid lg:grid-cols-[12rem_minmax(0,1fr)] lg:gap-12"{% endif %}>
      {% if not include_navigation %}
      <aside class="mb-10 lg:mb-0">
        <nav class="lg:sticky lg:top-8" aria-label="Documentation sections">
          <p class="mb-3 font-mono text-[10px] uppercase tracking-[.2em] text-slate-500">Contents</p>
          <div class="flex gap-2 overflow-x-auto pb-2 lg:block lg:space-y-2 lg:overflow-visible lg:pb-0">
            {% for anchor, label, icon in [("overview", "Overview", "layout-dashboard"), ("entities", "Features", "boxes"), ("datasets", "Datasets", "database"), ("dimensions", "Dimensions", "layers-3"), ("functions", "Functions", "braces")] %}
            <a href="#{{ anchor }}" class="flex shrink-0 items-center gap-2 rounded-lg px-3 py-2 font-mono text-xs text-slate-400 transition hover:bg-slate-900 hover:text-cyan-200"><i data-lucide="{{ icon }}" class="h-3.5 w-3.5 text-slate-400" aria-hidden="true"></i>{{ label }}</a>
            {% endfor %}
          </div>
        </nav>
      </aside>
      {% endif %}
      <main>
        {% block specification_sections %}
        {% include "spec/sections/overview.html.j2" %}
        {% include "spec/sections/entities.html.j2" %}
        {% include "spec/sections/dataset_list.html.j2" %}
        {% include "spec/sections/dimensions.html.j2" %}
        {% include "spec/sections/functions.html.j2" %}
        {% endblock %}
      </main>
    </div>
  </div>
{% endblock %}
