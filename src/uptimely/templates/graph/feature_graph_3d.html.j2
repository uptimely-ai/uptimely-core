{% extends "graph/base.html.j2" %}
{% from "graph/feature_graph_shared.html.j2" import node_details_panel, node_details_script %}
{% block title %}Uptimely 3D Feature Lineage{% endblock %}
{% block head %}
	<script src="https://unpkg.com/three@0.160.0/build/three.min.js"></script>
	<script src="https://unpkg.com/3d-force-graph@1.77.0/dist/3d-force-graph.min.js"></script>
	<script src="https://unpkg.com/three-spritetext@1.10.0/dist/three-spritetext.min.js"></script>
{% endblock %}
{% block graph_style %}
	.legend-separator { display: block; height: 1px; margin: 4px 0; background: #52616b; }
	.legend .function::before { clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%); }
{% endblock %}
{% block body %}
	<div class="panel">
		<div class="legend" aria-label="3D graph legend">
			<span style="--color:{{ style.feature_color }}">Feature sphere</span>
			<span class="legend-separator" aria-hidden="true"></span>
			{% for function_type, color in style.function_colors.items() %}
			<span class="function" style="--color:{{ color }}">{{ function_type|title }} octahedron</span>
			{% endfor %}
		</div>
	</div>
	{{ node_details_panel() }}
	<div id="graph"></div>
	<script>
		const data = {{ graph_data|safe }};
		const functionColors = {
			{% for function_type, color in style.function_colors.items() %}
			{{ function_type|tojson }}: '{{ color }}'{% if not loop.last %},{% endif %}
			{% endfor %}
		};
		const featureColor = '{{ style.feature_color }}';
{{ node_details_script() }}
		const graphContainer = document.getElementById('graph');
		const graph = ForceGraph3D()(graphContainer)
			.width(graphContainer.clientWidth)
			.height(graphContainer.clientHeight)
			.graphData(data)
			.backgroundColor('{{ style.background_color }}')
			.nodeLabel(node => `${node.is_function ? 'function' : 'feature'}: ${node.label}<br>entity: ${node.entity || 'n/a'}`)
			.nodeColor(node => node.is_function ? functionColors[node.function_type] : featureColor)
			.nodeRelSize({{ style.node_rel_size }})
			.nodeResolution({{ style.node_resolution }})
			.linkDirectionalArrowLength({{ style.arrow_length }})
			.linkDirectionalArrowRelPos({{ style.arrow_rel_pos }})
			.linkWidth({{ style.link_width }})
			.linkColor(() => '{{ style.link_color }}')
			.linkOpacity({{ style.link_opacity }})
			.onNodeClick(node => updateDetails(node))
			.nodeThreeObject(node => {
				const color = node.is_function ? functionColors[node.function_type] : featureColor;
				const material = new THREE.MeshLambertMaterial({ color });
				const isVariable = !node.is_function;
				const geometry = isVariable
					? new THREE.SphereGeometry({{ style.feature_node_size }}, 16, 12)
					: new THREE.OctahedronGeometry({{ style.function_node_size }}, 0);
				const mesh = new THREE.Mesh(geometry, material);

				if (!isVariable) {
					return mesh;
				}

				const group = new THREE.Group();
				group.add(mesh);
				const label = new SpriteText(node.label || '', 3.2, '{{ style.label_color }}');
				label.backgroundColor = 'rgba(16,24,32,0.72)';
				label.padding = 2;
				label.borderRadius = 2;
				label.position.set(0, 14, 0);
				group.add(label);
				return group;
			});
		const chargeForce = graph.d3Force('charge');
		chargeForce.strength({{ style.charge_strength }});
		chargeForce.distanceMax({{ style.charge_distance_max }});
		graph.d3Force('link').distance({{ style.link_distance }});
		window.addEventListener('resize', () => graph
			.width(graphContainer.clientWidth)
			.height(graphContainer.clientHeight));
		updateDetails(null);
	</script>
{% endblock %}
