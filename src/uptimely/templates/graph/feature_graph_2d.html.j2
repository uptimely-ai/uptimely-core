{% extends "graph/base.html.j2" %}
{% from "graph/feature_graph_shared.html.j2" import node_details_panel, node_details_script %}
{% block title %}Uptimely 2D Feature Lineage{% endblock %}
{% block head %}
	<script src="https://unpkg.com/force-graph@1.52.0/dist/force-graph.min.js"></script>
{% endblock %}
{% block graph_style %}
	.legend-separator { display: block; height: 1px; margin: 4px 0; background: #52616b; }
	.legend span::before { width: 18px; height: 12px; border: 1px solid var(--color);
		border-radius: 4px; box-sizing: border-box;
		background: radial-gradient(circle, var(--color) 0 3px, transparent 3.5px) 3px center / 6px 6px no-repeat; }
	.legend .function::before {
		background: linear-gradient(var(--color), var(--color)) 3px center / 6px 6px no-repeat; }
	.graph-controls { position: absolute; top: 70px; right: 20px; z-index: 1; }
	.graph-controls button { padding: 9px 14px; border: 1px solid #52616b; border-radius: 8px;
		background: #1c2b36; color: #e8edf2; font: inherit; cursor: pointer; }
	.graph-controls button:hover, .graph-controls button:focus-visible {
		border-color: #67e8f9; color: #67e8f9; }
{% endblock %}
{% block body %}
	<div class="panel">
		<div class="legend" aria-label="2D graph legend">
			<span style="--color:{{ style.feature_color }}">Feature</span>
			<span class="legend-separator" aria-hidden="true"></span>
			{% for function_type, color in style.function_colors.items() %}
			<span class="function" style="--color:{{ color }}">{{ function_type|title }} function</span>
			{% endfor %}
		</div>
	</div>
	<div class="graph-controls"><button id="fit-graph" type="button">Fit graph</button></div>
	{{ node_details_panel("details details-2d", "Selected item") }}
	<div id="graph"></div>
	<script>
		const data = {{ graph_data|safe }};
		const functionColors = {
			{% for function_type, color in style.function_colors.items() %}
			{{ function_type|tojson }}: '{{ color }}'{% if not loop.last %},{% endif %}
			{% endfor %}
		};
		const featureColor = '{{ style.feature_color }}';
{{ node_details_script("Selected item") }}
		const graphContainer = document.getElementById('graph');
		const rankNodes = (graphData) => {
			const children = new Map(graphData.nodes.map(node => [node.id, []]));
			const indegree = new Map(graphData.nodes.map(node => [node.id, 0]));
			for (const link of graphData.links) {
				children.get(link.source)?.push(link.target);
				indegree.set(link.target, (indegree.get(link.target) || 0) + 1);
			}
			const ranks = new Map(graphData.nodes.map(node => [node.id, 0]));
			const queue = graphData.nodes
				.filter(node => indegree.get(node.id) === 0)
				.map(node => node.id)
				.sort();
			for (let index = 0; index < queue.length; index++) {
				const source = queue[index];
				for (const target of children.get(source) || []) {
					ranks.set(target, Math.max(ranks.get(target), ranks.get(source) + 1));
					indegree.set(target, indegree.get(target) - 1);
					if (indegree.get(target) === 0) queue.push(target);
				}
			}
			const maxRank = Math.max(0, ...ranks.values());
			const unresolved = graphData.nodes
				.filter(node => indegree.get(node.id) > 0)
				.sort((a, b) => a.id.localeCompare(b.id));
			for (const node of unresolved) ranks.set(node.id, maxRank + 1);
			return ranks;
		};
		const nodeRanks = rankNodes(data);
		const rankGroups = new Map();
		for (const node of data.nodes) {
			node.rank = nodeRanks.get(node.id);
			node.cardWidth = Math.min(280, Math.max(112, (node.label || node.id).length * 8 + 52));
			node.cardHeight = 38;
			if (!rankGroups.has(node.rank)) rankGroups.set(node.rank, []);
			rankGroups.get(node.rank).push(node);
		}
		for (const nodes of rankGroups.values()) {
			nodes.sort((a, b) => a.label.localeCompare(b.label) || a.id.localeCompare(b.id));
		}
		const ranksInOrder = [...rankGroups.keys()].sort((a, b) => a - b);
		const rankWidths = new Map(ranksInOrder.map(rank => [
			rank,
			Math.max(...rankGroups.get(rank).map(node => Math.min(280, node.label.length * 8 + 52)))
		]));
		const rankOffsets = new Map();
		let totalWidth = 0;
		for (const rank of ranksInOrder) {
			rankOffsets.set(rank, totalWidth + rankWidths.get(rank) / 2);
			totalWidth += rankWidths.get(rank) + 130;
		}
		for (const rank of ranksInOrder) {
			const nodes = rankGroups.get(rank);
			nodes.forEach((node, index) => {
				node.fx = rankOffsets.get(rank) - totalWidth / 2;
				node.fy = (index - (nodes.length - 1) / 2) * 76;
				node.x = node.fx;
				node.y = node.fy;
			});
		}
		const selectAtPointer = (event) => {
			const bounds = graphContainer.getBoundingClientRect();
			const point = graph.screen2GraphCoords(
				event.clientX - bounds.left, event.clientY - bounds.top);
			const node = [...data.nodes].reverse().find(node =>
				Math.abs(point.x - node.x) <= node.cardWidth / 2 &&
				Math.abs(point.y - node.y) <= node.cardHeight / 2);
			if (node) updateDetails(node);
		};
		let initialFitComplete = false;
		const graph = ForceGraph()(graphContainer)
			.width(graphContainer.clientWidth)
			.height(graphContainer.clientHeight)
			.backgroundColor('{{ style.background_color }}')
			.nodeLabel(node => `${node.is_function ? 'function' : 'feature'}: ${node.label}<br>entity: ${node.entity || 'n/a'}`)
			.nodeRelSize(6)
			.nodeVal(node => node.is_function ? 7 : 5)
			.nodeColor(node => node.is_function ? functionColors[node.function_type] || '#b279a2' : featureColor)
			.nodeCanvasObjectMode(() => 'replace')
			.nodeCanvasObject((node, ctx) => {
				const label = node.label || node.id;
				const isFunction = node.is_function === true;
				const color = isFunction
					? functionColors[node.function_type] || '#b279a2'
					: featureColor;
				const width = node.cardWidth;
				const height = node.cardHeight;
				const left = node.x - width / 2;
				const top = node.y - height / 2;
				ctx.save();
				ctx.shadowColor = 'rgba(0, 0, 0, .36)';
				ctx.shadowBlur = 14;
				ctx.shadowOffsetY = 4;
				ctx.beginPath();
				ctx.roundRect(left, top, width, height, 12);
				ctx.fillStyle = isFunction ? '#1a2732' : '#172a35';
				ctx.fill();
				ctx.shadowColor = 'transparent';
				ctx.lineWidth = 1.5;
				ctx.strokeStyle = color;
				ctx.stroke();
				ctx.beginPath();
				if (isFunction) {
					ctx.roundRect(left + 12, node.y - 6, 12, 12, 3);
				} else {
					ctx.arc(left + 18, node.y, 6, 0, 2 * Math.PI);
				}
				ctx.fillStyle = color;
				ctx.fill();
				ctx.fillStyle = '#e8edf2';
				ctx.font = '600 12px "DM Sans", sans-serif';
				ctx.textAlign = 'left';
				ctx.textBaseline = 'middle';
				ctx.fillText(label, left + 34, node.y, width - 46);
				ctx.restore();
			})
			.nodePointerAreaPaint((node, color, ctx) => {
				ctx.fillStyle = color;
				ctx.fillRect(node.x - node.cardWidth / 2, node.y - node.cardHeight / 2,
					node.cardWidth, node.cardHeight);
			})
			.linkColor(() => '{{ style.link_color }}')
			.linkWidth({{ style.link_width }})
			.linkDirectionalArrowLength(5)
			.linkDirectionalArrowRelPos(1)
			.linkDirectionalParticles(2)
			.linkDirectionalParticleWidth(2)
			.linkDirectionalParticleSpeed(0.003)
			.onNodeClick((_node, event) => selectAtPointer(event))
			.onLinkClick((_link, event) => selectAtPointer(event))
			.onBackgroundClick(event => selectAtPointer(event))
			.cooldownTicks(1)
			.onEngineStop(() => {
				if (!initialFitComplete) {
					graph.zoomToFit(0, 140);
					initialFitComplete = true;
				}
			})
			.graphData(data);
		const fitGraph = () => graph.zoomToFit(600, 140);
		document.getElementById('fit-graph').addEventListener('click', fitGraph);
		window.addEventListener('resize', () => {
			graph.width(graphContainer.clientWidth).height(graphContainer.clientHeight);
			fitGraph();
		});
		updateDetails(null);
	</script>
{% endblock %}
