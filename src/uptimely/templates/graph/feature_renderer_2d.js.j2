	function create2D(graphContainer, data, updateDetails) {
		function rankNodes(graphData) {
			const children = new Map(graphData.nodes.map(node => [node.id, []]));
			const indegree = new Map(graphData.nodes.map(node => [node.id, 0]));
			for (const link of graphData.links) {
				children.get(link.source)?.push(link.target);
				indegree.set(link.target, (indegree.get(link.target) || 0) + 1);
			}
			const ranks = new Map(graphData.nodes.map(node => [node.id, 0]));
			const queue = graphData.nodes
				.filter(node => indegree.get(node.id) === 0)
				.map(node => node.id)
				.sort();
			for (let index = 0; index < queue.length; index++) {
				const source = queue[index];
				for (const target of children.get(source) || []) {
					ranks.set(target, Math.max(ranks.get(target), ranks.get(source) + 1));
					indegree.set(target, indegree.get(target) - 1);
					if (indegree.get(target) === 0) queue.push(target);
				}
			}
			const maxRank = Math.max(0, ...ranks.values());
			const unresolved = graphData.nodes
				.filter(node => indegree.get(node.id) > 0)
				.sort((a, b) => a.id.localeCompare(b.id));
			for (const node of unresolved) ranks.set(node.id, maxRank + 1);
			return ranks;
		}

		function prepareGraphLayout(graphData) {
			const entityNames = [...new Set(graphData.nodes.map(node => node.entity || 'Unassigned'))]
				.sort((a, b) => a.localeCompare(b));
			const laneLabelWidth = Math.min(
				220,
				Math.max(80, ...entityNames.map(entity => entity.length * 7))
			);
			const nodeRanks = rankNodes(graphData);
			const rankGroups = new Map();
			for (const node of graphData.nodes) {
				node.rank = nodeRanks.get(node.id);
				node.cardWidth = Math.min(280, Math.max(112, (node.label || node.id).length * 8 + 52));
				node.cardHeight = 38;
				if (!rankGroups.has(node.rank)) rankGroups.set(node.rank, new Map());
				const entity = node.entity || 'Unassigned';
				if (!rankGroups.get(node.rank).has(entity)) rankGroups.get(node.rank).set(entity, []);
				rankGroups.get(node.rank).get(entity).push(node);
			}
			for (const lanes of rankGroups.values()) {
				for (const nodes of lanes.values()) {
					nodes.sort((a, b) => a.label.localeCompare(b.label) || a.id.localeCompare(b.id));
				}
			}
			const maxLaneNodes = Math.max(
				1,
				...entityNames.map(entity =>
					Math.max(0, ...[...rankGroups.values()].map(lanes => lanes.get(entity)?.length || 0))
				)
			);
			const laneHeight = Math.max(96, maxLaneNodes * 54 + 24);
			const laneSpacing = laneHeight + 24;
			const lanePositions = new Map(entityNames.map((entity, index) => [
				entity,
				(index - (entityNames.length - 1) / 2) * laneSpacing
			]));
			const ranksInOrder = [...rankGroups.keys()].sort((a, b) => a - b);
			const rankWidths = new Map(ranksInOrder.map(rank => [
				rank,
				Math.max(...[...rankGroups.get(rank).values()].flat().map(node => node.cardWidth))
			]));
			const rankOffsets = new Map();
			let graphWidth = 0;
			for (const rank of ranksInOrder) {
				rankOffsets.set(rank, graphWidth + rankWidths.get(rank) / 2);
				graphWidth += rankWidths.get(rank) + 130;
			}
			for (const rank of ranksInOrder) {
				for (const entity of entityNames) {
					const nodes = rankGroups.get(rank).get(entity) || [];
					nodes.forEach((node, index) => {
						node.fx = rankOffsets.get(rank) - graphWidth / 2 + laneLabelWidth + 100;
						node.fy = lanePositions.get(entity)
							+ (index - (nodes.length - 1) / 2) * 54;
						node.x = node.fx;
						node.y = node.fy;
					});
				}
			}
			return { entityNames, laneHeight, laneLabelWidth, lanePositions, graphWidth };
		}

		const layout = prepareGraphLayout(data);
		function selectAtPointer(event) {
			const bounds = graphContainer.getBoundingClientRect();
			const point = graph.screen2GraphCoords(
				event.clientX - bounds.left, event.clientY - bounds.top);
			const node = [...data.nodes].reverse().find(node =>
				Math.abs(point.x - node.x) <= node.cardWidth / 2 &&
				Math.abs(point.y - node.y) <= node.cardHeight / 2);
			if (node) updateDetails(node);
		}

		function drawEntityLanes(ctx, globalScale) {
			const scale = Math.max(globalScale, 0.01);
			const laneLeft = data.nodes.length
				? Math.min(...data.nodes.map(node => node.x - node.cardWidth / 2))
					- layout.laneLabelWidth - 24
				: -layout.laneLabelWidth - 24;
			const laneRight = layout.graphWidth - layout.graphWidth / 2 + layout.laneLabelWidth + 100;
			ctx.save();
			ctx.font = `600 ${12 / scale}px "DM Sans", sans-serif`;
			ctx.textAlign = 'right';
			ctx.textBaseline = 'middle';
			for (const [index, entity] of layout.entityNames.entries()) {
				const centerY = layout.lanePositions.get(entity);
				const top = centerY - layout.laneHeight / 2;
				ctx.fillStyle = index % 2 === 0 ? 'rgba(143, 163, 181, .07)' : 'rgba(143, 163, 181, .03)';
				ctx.fillRect(laneLeft, top, laneRight - laneLeft, layout.laneHeight);
				ctx.strokeStyle = 'rgba(143, 163, 181, .4)';
				ctx.lineWidth = 1 / scale;
				ctx.beginPath();
				ctx.moveTo(laneLeft, top);
				ctx.lineTo(laneRight, top);
				ctx.stroke();
				ctx.fillStyle = '#9fb3c3';
				ctx.fillText(entity, laneLeft + layout.laneLabelWidth, centerY, layout.laneLabelWidth);
			}
			if (layout.entityNames.length) {
				const lastLaneY = layout.lanePositions.get(
					layout.entityNames[layout.entityNames.length - 1]
				);
				ctx.beginPath();
				ctx.moveTo(laneLeft, lastLaneY + layout.laneHeight / 2);
				ctx.lineTo(laneRight, lastLaneY + layout.laneHeight / 2);
				ctx.stroke();
			}
			ctx.restore();
		}

		function drawNode(node, ctx) {
			const label = node.label || node.id;
			const isFunction = node.is_function === true;
			const color = isFunction
				? functionColors[node.function_type] || '#b279a2'
				: featureColor;
			const width = node.cardWidth;
			const left = node.x - width / 2;
			ctx.save();
			ctx.shadowColor = 'rgba(0, 0, 0, .36)';
			ctx.shadowBlur = 14;
			ctx.shadowOffsetY = 4;
			ctx.beginPath();
			ctx.roundRect(left, node.y - node.cardHeight / 2, width, node.cardHeight, 12);
			ctx.fillStyle = isFunction ? '#1a2732' : '#172a35';
			ctx.fill();
			ctx.shadowColor = 'transparent';
			ctx.lineWidth = 1.5;
			ctx.strokeStyle = color;
			ctx.stroke();
			ctx.beginPath();
			if (isFunction) {
				ctx.roundRect(left + 12, node.y - 6, 12, 12, 3);
			} else {
				ctx.arc(left + 18, node.y, 6, 0, 2 * Math.PI);
			}
			ctx.fillStyle = color;
			ctx.fill();
			ctx.fillStyle = '#e8edf2';
			ctx.font = '600 12px "DM Sans", sans-serif';
			ctx.textAlign = 'left';
			ctx.textBaseline = 'middle';
			ctx.fillText(label, left + 34, node.y, width - 46);
			ctx.restore();
		}

		let initialFitComplete = false;
		const graph = ForceGraph()(graphContainer)
			.width(graphContainer.clientWidth)
			.height(graphContainer.clientHeight)
			.backgroundColor('{{ style.background_color }}')
			.nodeLabel(node => `${node.is_function ? 'function' : 'feature'}: ${node.label}<br>entity: ${node.entity || 'n/a'}`)
			.nodeRelSize(6)
			.nodeVal(node => node.is_function ? 7 : 5)
			.nodeColor(node => node.is_function ? functionColors[node.function_type] || '#b279a2' : featureColor)
			.onRenderFramePre(drawEntityLanes)
			.nodeCanvasObjectMode(() => 'replace')
			.nodeCanvasObject(drawNode)
			.nodePointerAreaPaint((node, color, ctx) => {
				ctx.fillStyle = color;
				ctx.fillRect(node.x - node.cardWidth / 2, node.y - node.cardHeight / 2,
					node.cardWidth, node.cardHeight);
			})
			.linkColor(() => '{{ style.link_color }}')
			.linkWidth({{ style.link_width }})
			.linkDirectionalArrowLength(5)
			.linkDirectionalArrowRelPos(1)
			.linkDirectionalParticles(2)
			.linkDirectionalParticleWidth(2)
			.linkDirectionalParticleSpeed(0.003)
			.onNodeClick((_node, event) => selectAtPointer(event))
			.onLinkClick((_link, event) => selectAtPointer(event))
			.onBackgroundClick(event => selectAtPointer(event))
			.cooldownTicks(1)
			.onEngineStop(() => {
				if (!initialFitComplete) {
					graph.zoomToFit(0, Math.max(140, layout.laneLabelWidth + 24));
					initialFitComplete = true;
				}
			})
			.graphData(data);

		function fitGraph() {
			graph.zoomToFit(600, Math.max(140, layout.laneLabelWidth + 24));
		}

		function resizeGraph() {
			graph.width(graphContainer.clientWidth).height(graphContainer.clientHeight);
			fitGraph();
		}

		return { graph, fit: fitGraph, resize: resizeGraph };
	}
