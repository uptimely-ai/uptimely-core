<!DOCTYPE html>
<html lang="en" class="bg-slate-950">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}OpenAnalytics documentation{% endblock %}</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {theme: {extend: {fontFamily: {
      sans: ["DM Sans", "sans-serif"], display: ["Space Grotesk", "sans-serif"], mono: ["JetBrains Mono", "monospace"]
    }}}}
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@500&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
  {% block head %}{% endblock %}
  <style>
    :root { --site-nav-width: {% if include_navigation %}224px{% else %}0px{% endif %}; }
    .site-content { margin-left: var(--site-nav-width); min-width: 0; }
    .site-nav { position: fixed; inset: 0 auto 0 0; width: var(--site-nav-width); z-index: 50;
      box-sizing: border-box; display: flex; flex-direction: column; gap: 8px;
      padding: 24px 16px; overflow-y: auto;
      background: #0f172a; border-right: 1px solid #334155; font: 14px "DM Sans", sans-serif; }
    .site-nav a { display: flex; align-items: center; gap: 8px; padding: 10px 12px; border-radius: 8px;
      color: #cbd5e1; text-decoration: none; overflow-wrap: anywhere; }
    .site-nav .nav-icon { width: 16px; height: 16px; flex-shrink: 0; }
    .site-nav a span { min-width: 0; }
    .site-nav a:hover, .site-nav a:focus-visible { color: #fff; text-decoration: underline; }
    .site-nav a[aria-current="page"] { color: #67e8f9; background: #1e293b; }
    .site-brand { font-weight: 700; margin-bottom: 24px; }
    .site-subnav { margin-left: 16px; padding-left: 8px; border-left: 1px solid #334155; }
    .site-subnav a { font-size: 12px; padding: 8px 12px; }
    @media (max-width: 640px) {
      :root { --site-nav-width: {% if include_navigation %}136px{% else %}0px{% endif %}; }
      .site-nav { padding: 16px 8px; font-size: 12px; }
      .site-nav a { padding: 10px 8px; }
    }
    {% block style %}{% endblock %}
  </style>
</head>
<body class="{% block body_class %}min-h-screen bg-slate-950 font-sans text-slate-200{% endblock %}">
  {% if include_navigation %}
  {% set rel_root = root_path or "" %}
  <nav class="site-nav" aria-label="Documentation pages">
    <a class="site-brand" href="{{ rel_root }}index.html">openanalytics/docs</a>
    {% for page, href, label, icon in [("spec", rel_root ~ "spec/overview.html", "Specification", "book-open"), ("graph", rel_root ~ "graph/3d.html", "Feature graph", "git-fork"), ("plan", rel_root ~ "plan/overview.html", "Execution plan", "workflow")] %}
    <a href="{{ href }}"{% if active_page == page and not active_section %} aria-current="page"{% endif %}><i class="nav-icon" data-lucide="{{ icon }}" aria-hidden="true"></i><span>{{ label }}</span></a>
    {% if page == "spec" %}
    <div class="site-subnav" role="group" aria-label="Specification sections">
      {% for section, section_href, section_label, section_icon in [
        ("overview", rel_root ~ "spec/overview.html", "Overview", "layout-dashboard"),
        ("features", rel_root ~ "spec/features.html", "Features", "boxes"),
        ("entities", rel_root ~ "spec/entities.html", "Entities", "boxes"),
        ("datasets", rel_root ~ "spec/datasets.html", "Datasets", "table"),
        ("dimensions", rel_root ~ "spec/dimensions.html", "Dimensions", "layers-3"),
        ("functions", rel_root ~ "spec/functions.html", "Functions", "braces")
      ] %}
      <a href="{{ section_href }}"{% if active_page == "spec" and active_section == section %} aria-current="page"{% endif %}><i class="nav-icon" data-lucide="{{ section_icon }}" aria-hidden="true"></i><span>{{ section_label }}</span></a>
      {% endfor %}
    </div>
    {% elif page == "plan" %}
    <div class="site-subnav" role="group" aria-label="Execution plan sections">
      {% for section, section_href, section_label, section_icon in [
        ("overview", rel_root ~ "plan/overview.html", "Overview", "layout-dashboard"),
        ("graph_2d", rel_root ~ "plan/2d.html", "2D graph", "git-fork"),
        ("graph_3d", rel_root ~ "plan/3d.html", "3D graph", "git-fork"),
        ("stages", rel_root ~ "plan/stages.html", "Stages", "layers-3")
      ] %}
      <a href="{{ section_href }}"{% if active_page == "plan" and active_section == section %} aria-current="page"{% endif %}><i class="nav-icon" data-lucide="{{ section_icon }}" aria-hidden="true"></i><span>{{ section_label }}</span></a>
      {% endfor %}
    </div>
    {% elif page == "graph" %}
    <div class="site-subnav" role="group" aria-label="Feature graph views">
      {% for section, section_href, section_label, section_icon in [
        ("2d", rel_root ~ "graph/2d.html", "2D graph", "git-fork"),
        ("3d", rel_root ~ "graph/3d.html", "3D graph", "git-fork")
      ] %}
      <a href="{{ section_href }}"{% if active_page == "graph" and active_section == section %} aria-current="page"{% endif %}><i class="nav-icon" data-lucide="{{ section_icon }}" aria-hidden="true"></i><span>{{ section_label }}</span></a>
      {% endfor %}
    </div>
    {% endif %}
    {% endfor %}
  </nav>
  {% endif %}
  <div class="site-content">
    {% block content %}{% endblock %}
  </div>
  {% block scripts %}
  <script src="https://unpkg.com/lucide@latest"></script><script>lucide.createIcons();</script>
  {% endblock %}
</body>
</html>
