{% from "icons.html.j2" import icon, icons %}
<!DOCTYPE html>
<html lang="en" class="bg-slate-950">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}OpenAnalytics documentation{% endblock %}</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {theme: {extend: {fontFamily: {
      sans: ["DM Sans", "sans-serif"], display: ["Space Grotesk", "sans-serif"], mono: ["JetBrains Mono", "monospace"]
    }}}}
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@500&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
  {% block head %}{% endblock %}
  <style>
    :root { --site-nav-width: {% if include_navigation %}224px{% else %}0px{% endif %}; }
    {% for key, definition in icons.items() %}
    .icon--{{ key }} { --icon-color: {{ definition[1] }}; --icon-tint: {{ definition[2] }}; }
    {% endfor %}
    .site-icon { color: var(--icon-color); width: 20px; height: 20px; flex-shrink: 0; }
    .title-with-icon { display: flex; align-items: center; gap: 12px; }
    .title-icon { width: 28px; height: 28px; }
    .site-content { margin-left: var(--site-nav-width); min-width: 0; }
    .site-nav { position: fixed; inset: 0 auto 0 0; width: var(--site-nav-width); z-index: 50;
      box-sizing: border-box; display: flex; flex-direction: column; gap: 8px;
      padding: 24px 16px; overflow-y: auto;
      background: #0f172a; border-right: 1px solid #334155; font: 14px "DM Sans", sans-serif; }
    .site-nav a { display: flex; align-items: center; gap: 8px; padding: 10px 12px; border-radius: 8px;
      color: #cbd5e1; text-decoration: none; overflow-wrap: anywhere; }
    .site-nav .nav-icon { width: 16px; height: 16px; flex-shrink: 0; }
    .site-nav a span { min-width: 0; }
    .site-nav a:hover, .site-nav a:focus-visible { color: #fff; text-decoration: underline; }
    .site-nav a[aria-current="page"] { color: #67e8f9; background: #1e293b; }
    .site-brand { font-weight: 700; margin-bottom: 24px; }
    .site-subnav { margin-left: 16px; padding-left: 8px; border-left: 1px solid #334155; }
    .site-subnav a { font-size: 12px; padding: 8px 12px; }
    @media (max-width: 640px) {
      :root { --site-nav-width: {% if include_navigation %}136px{% else %}0px{% endif %}; }
      .site-nav { padding: 16px 8px; font-size: 12px; }
      .site-nav a { padding: 10px 8px; }
    }
    {% block style %}{% endblock %}
  </style>
</head>
<body class="{% block body_class %}min-h-screen bg-slate-950 font-sans text-slate-200{% endblock %}">
  {% if include_navigation %}
  {% set rel_root = root_path or "" %}
  <nav class="site-nav" aria-label="Documentation pages">
    <a class="site-brand" href="{{ rel_root }}{{ index_filename or 'index.html' }}"{% if active_page == "home" %} aria-current="page"{% endif %}>{{ icon("home", "nav-icon") }}<span>openanalytics/docs</span></a>
    {% for page, label, icon_key in [("spec", "Specification", "specification"), ("plan", "Plan", "execution"), ("execution", "Execution", "execution")] %}
    <a href="{{ rel_root }}{{ website_pages[page]['lineage' if page == 'execution' else 'overview'] }}"{% if active_page == page and not active_section %} aria-current="page"{% endif %}>{{ icon(icon_key, "nav-icon") }}<span>{{ label }}</span></a>
    {% if page == "spec" %}
    <div class="site-subnav" role="group" aria-label="Specification sections">
      {% for section, section_label, section_icon in [
        ("overview", "Overview", "overview"),
        ("features", "Features", "features"),
        ("entities", "Entities", "entities"),
        ("datasets", "Datasets", "datasets"),
        ("dimensions", "Dimensions", "dimensions"),
        ("functions", "Functions", "functions"),
        ("graph", "Feature graph", "lineage")
      ] %}
      {% set section_href = website_pages["graph"]["lineage"] if section == "graph" else website_pages["spec"][section] %}
      <a href="{{ rel_root }}{{ section_href }}"{% if (active_page == "spec" and active_section == section) or (active_page == "graph" and section == "graph") %} aria-current="page"{% endif %}>{{ icon(section_icon, "nav-icon") }}<span>{{ section_label }}</span></a>
      {% endfor %}
    </div>
    {% elif page == "plan" %}
    <div class="site-subnav" role="group" aria-label="Plan sections">
      {% for section, section_label, section_icon in [
        ("overview", "Overview", "execution"),
        ("graph", "Execution graph", "execution-graph"),
        ("stages", "Stages", "stages")
      ] %}
      <a href="{{ rel_root }}{{ website_pages['plan'][section] }}"{% if active_page == "plan" and active_section == section %} aria-current="page"{% endif %}>{{ icon(section_icon, "nav-icon") }}<span>{{ section_label }}</span></a>
      {% endfor %}
    </div>
    {% elif page == "execution" %}
    <div class="site-subnav" role="group" aria-label="Execution sections">
      <a href="{{ rel_root }}{{ website_pages['execution']['lineage'] }}"{% if active_page == "execution" and active_section == "lineage" %} aria-current="page"{% endif %}>{{ icon("lineage", "nav-icon") }}<span>Data lineage</span></a>
    </div>
    {% endif %}
    {% endfor %}
  </nav>
  {% endif %}
  <div class="site-content">
    {% block content %}{% endblock %}
  </div>
  {% block scripts %}
  <script src="https://unpkg.com/lucide@latest"></script><script>lucide.createIcons();</script>
  {% endblock %}
</body>
</html>
