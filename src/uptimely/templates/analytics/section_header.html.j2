{% from "icons.html.j2" import icon %}
{% macro section_header(title, description, count=none, count_label="") %}
<header class="mb-8 border-b border-slate-800 pb-6">
  <p class="mb-3 font-mono text-[10px] uppercase tracking-[.18em] text-slate-500">Analytics reference</p>
  <div class="flex flex-wrap items-center gap-3">
    <h1 class="title-with-icon font-display text-3xl font-semibold tracking-tight text-white">{{ icon(title|lower, "title-icon") }}<span>{{ title }}</span></h1>
    {% if count is not none %}
    <span class="rounded-md border border-slate-700 bg-slate-900 px-2.5 py-1 font-mono text-xs text-slate-400">{{ count }} {{ count_label }}</span>
    {% endif %}
  </div>
  <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-400">{{ description }}</p>
</header>
{% endmacro %}
